---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Cta from "../components/sections/Cta.astro";
import PageHero from "../components/platform/PageHero.astro";
import SoonBadge from "../components/platform/SoonBadge.astro";
import Todo from "../components/platform/Todo.astro";
import { status } from "../data/platform";
import {
  ArrowRight,
  FileSpreadsheet,
  Mail,
  Home,
  ShieldCheck,
  Bot,
  BellRing,
  Inbox,
  Sparkles,
  UserCheck,
  TrendingUp,
} from "@lucide/astro";

type UseCase = {
  id: string;
  icon: typeof Mail;
  title: string;
  soon: boolean;
  rows: { label: string; text: string }[];
  measured?: boolean;
  mock: { channel: string; title: string; state: string; tone: string; lines: string[] };
};

const useCases: UseCase[] = [
  {
    id: "borderellen",
    icon: FileSpreadsheet,
    title: "Borderellen en totalencontrole",
    soon: status.reconcileTotals === "soon",
    rows: [
      {
        label: "Wat er binnenkomt",
        text: "Een borderel of prolongatienota van een maatschappij, per mail.",
      },
      {
        label: "Wat Insync doet",
        text: "Leest de totalen uit en legt ze naast de cijfers in je backoffice. Klopt het, dan sluit de zaak vanzelf. Wijkt het af, dan zet Insync een taak in je backoffice met het verschil en de reden.",
      },
      { label: "Wat jij doet", text: "Alleen naar de afwijkingen kijken." },
      {
        label: "Wat het oplevert",
        text: "Geen borderellen meer handmatig nalopen. Je team ziet alleen wat niet klopt.",
      },
    ],
    measured: true,
    mock: {
      channel: "Borderel · per mail",
      title: "Prolongatienota september",
      state: "Wijkt af",
      tone: "warning",
      lines: ["Totaal premie: verschil van € 62,87", "Taak in backoffice: controleer polis 4471"],
    },
  },
  {
    id: "klantvragen",
    icon: Mail,
    title: "Klantvragen per mail",
    soon: status.clientQuestions === "soon",
    rows: [
      {
        label: "Wat er binnenkomt",
        text: "Een klant mailt een vraag, over een polis, een dekking of een wijziging.",
      },
      {
        label: "Wat Insync doet",
        text: "Zoekt de klant en de polis erbij, leest de relevante voorwaarden, en zet een conceptantwoord, een notitie voor het dossier en zo nodig een taak klaar.",
      },
      {
        label: "Wat jij doet",
        text: "Het antwoord lezen, aanpassen waar nodig, akkoord geven. Insync verstuurt en legt vast.",
      },
      {
        label: "Wat het oplevert",
        text: "Geen zoekwerk en geen overtypen. Je klant krijgt sneller antwoord.",
      },
    ],
    measured: true,
    mock: {
      channel: "Klantvraag · per mail",
      title: "M. de Vries · Reisverzekering",
      state: "Wacht op jou",
      tone: "warning",
      lines: ["Conceptantwoord klaar", "Notitie in dossier · taak voor Sanne"],
    },
  },
  {
    id: "wijzigingen",
    icon: Home,
    title: "Wijzigingen en verzoeken",
    soon: status.clientRequests === "soon",
    rows: [
      {
        label: "Wat er binnenkomt",
        text: "Een klant geeft een verhuizing, een nieuwe auto of een ander gegeven door.",
      },
      {
        label: "Wat Insync doet",
        text: "Herkent het verzoek en zet de taak klaar voor de juiste collega, met alle gegevens erbij.",
      },
      { label: "Wat jij doet", text: "De taak oppakken in je backoffice." },
      { label: "Wat het oplevert", text: "Geen verzoek dat in een mailbox blijft hangen." },
    ],
    mock: {
      channel: "Verzoek · per mail",
      title: "Verhuizing doorgeven · J. Bakker",
      state: "Bij Sanne",
      tone: "info",
      lines: ["Nieuw adres herkend", "Taak klaargezet met alle gegevens"],
    },
  },
  {
    id: "schademeldingen",
    icon: ShieldCheck,
    title: "Schademeldingen",
    soon: status.claimCases === "soon",
    rows: [
      {
        label: "Wat er binnenkomt",
        text: "Een klant meldt een schade via het klantportaal, met foto's en documenten.",
      },
      {
        label: "Wat Insync doet",
        text: "Maakt van de melding een complete zaak, zet de relevante passages uit de polisvoorwaarden erbij, met bronverwijzing, en bereidt een bericht aan de klant voor.",
      },
      {
        label: "Wat jij doet",
        text: "De behandelaar beoordeelt en beslist. Insync legt het besluit vast.",
      },
      {
        label: "Wat het oplevert",
        text: "Geen onvolledige meldingen meer en geen voorwaarden doorbladeren. Je klant hoort sneller iets.",
      },
    ],
    mock: {
      channel: "Schademelding · klantportaal",
      title: "Autoruit · K. Jansen",
      state: "Wacht op jou",
      tone: "warning",
      lines: ["Melding compleet, 3 foto's", "Voorwaarden art. 7.1 en 7.4 erbij"],
    },
  },
  {
    id: "ai-assistent",
    icon: Bot,
    title: "AI-assistent voor je team",
    soon: status.aiAssistant === "soon",
    rows: [
      {
        label: "Wanneer",
        text: "Voor werk dat niet in een vast patroon past. Een klant aan de telefoon die verhuist, een lastige dekkingsvraag, een klachtdossier.",
      },
      {
        label: "Wat Insync doet",
        text: "Zoekt in het dossier en de voorwaarden, en zet wat de administratie raakt klaar als voorstel. Ook hier: niets gebeurt zonder akkoord.",
      },
      {
        label: "Wat jij doet",
        text: "Vragen stellen in gewone taal, ook met je stem, en akkoord geven.",
      },
      {
        label: "Extra",
        text: "Voorwaarden van verschillende maatschappijen naast elkaar leggen, met per verschil de passage waar het staat.",
      },
    ],
    mock: {
      channel: "AI-assistent",
      title: "\"Is de caravan meeverzekerd in Frankrijk?\"",
      state: "Antwoord met bron",
      tone: "success",
      lines: ["Passage gevonden: art. 3.2, Europa gedekt", "Notitie voor het dossier klaargezet"],
    },
  },
];

const tones: Record<string, string> = {
  warning: "bg-warning/10 text-warning-dark",
  info: "bg-primary/10 text-primary",
  success: "bg-success/10 text-success-dark",
};

const rowIcons = [Inbox, Sparkles, UserCheck, TrendingUp];
---

<Layout
  title="Toepassingen"
  description="Borderellen, klantvragen per mail, schademeldingen en meer. Bekijk wat Insync voor je kantoor voorbereidt en afhandelt."
>
  <PageHero
    eyebrow="Toepassingen"
    title="Wat Insync voor je oppakt"
    subtitle="Elk soort werk dat terugkomt, kan Insync leren. We beginnen bij het werk dat de meeste tijd kost."
    secondary={{ href: "/platform", label: "Hoe het platform werkt" }}
  >
    <nav class="mt-14 flex flex-wrap justify-center gap-2" aria-label="Toepassingen">
      {
        useCases.map((item) => (
          <a
            href={`#${item.id}`}
            class="inline-flex items-center gap-2 rounded-full border bg-white px-4 py-2 text-sm font-medium hover:border-primary/40 hover:text-primary duration-150"
          >
            <item.icon class="size-4" />
            {item.title}
          </a>
        ))
      }
    </nav>
  </PageHero>

  {
    useCases.map((item, i) => (
      <section id={item.id} class:list={["py-16 sm:py-24 scroll-mt-24", i % 2 === 0 && "bg-muted/20 grain"]}>
        <div class="container relative z-10">
          <div class="grid items-center gap-12 [&>*]:min-w-0 lg:grid-cols-[1.3fr_1fr] max-w-6xl mx-auto">
            <div data-aos="custom-fade-up" data-aos-duration="400" data-aos-once="true">
              <div class="mb-4 flex items-center gap-3">
                <span class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <item.icon class="size-5" />
                </span>
                {item.soon && <SoonBadge />}
              </div>
              <h2 class="h3 mb-6">{item.title}</h2>
              <dl class="grid gap-5 sm:grid-cols-2">
                {item.rows.map((row, k) => {
                  const RowIcon = rowIcons[k];
                  return (
                    <div>
                      <dt class="mb-1 flex items-center gap-2 text-sm font-semibold">
                        <RowIcon class="size-4 text-primary" />
                        {row.label}
                      </dt>
                      <dd class="text-muted-foreground">{row.text}</dd>
                    </div>
                  );
                })}
              </dl>
              {item.measured && (
                <div class="mt-5">
                  <Todo>cijfer</Todo>
                </div>
              )}
            </div>
            <div data-aos="custom-zoom-in" data-aos-duration="500" data-aos-once="true">
              <div class="rounded-2xl border border-border/60 bg-white p-5 shadow-xl shadow-primary/10">
                <div class="mb-3 flex items-start justify-between gap-3">
                  <div>
                    <div class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                      {item.mock.channel}
                    </div>
                    <div class="mt-1 font-semibold">{item.mock.title}</div>
                  </div>
                  <span class:list={["shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold", tones[item.mock.tone]]}>
                    {item.mock.state}
                  </span>
                </div>
                <ul class="space-y-2">
                  {item.mock.lines.map((line) => (
                    <li class="rounded-xl bg-muted/70 px-3 py-2.5 text-sm">{line}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- Signalen -->
  <section id="signalen" class="py-16 sm:py-24 scroll-mt-24">
    <div class="container">
      <div
        class="max-w-4xl mx-auto rounded-3xl border border-dashed border-primary/40 p-8 sm:p-12"
        data-aos="custom-fade-up"
        data-aos-duration="400"
        data-aos-once="true"
      >
        <div class="mb-4 flex items-center gap-3">
          <span class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <BellRing class="size-5" />
          </span>
          {status.signals === "soon" && <SoonBadge />}
        </div>
        <h2 class="h3 mb-4">Signalen</h2>
        <p class="text-lg text-muted-foreground mb-3">
          Insync signaleert zelf werk dat niemand aanvraagt: een prolongatie die eraan komt, een
          mogelijk gat in de dekking, verplichte communicatie bij een voorwaardenwijziging.
        </p>
        <p class="text-muted-foreground">
          Gebundeld per klant en gedoseerd, zodat je team niet overspoeld wordt.
        </p>
      </div>
    </div>
  </section>

  <!-- Eigen werk -->
  <section class="py-16 sm:py-24 bg-muted/20 grain">
    <div class="container relative z-10">
      <div
        class="max-w-3xl mx-auto text-center"
        data-aos="custom-fade-up"
        data-aos-duration="400"
        data-aos-once="true"
      >
        <span class="label mb-4 inline-block">Jouw kantoor</span>
        <h2 class="mb-4">Ander werk dat steeds terugkomt?</h2>
        <p class="text-lg text-muted-foreground mb-8">
          Elk soort werk met een vast patroon kan een toepassing worden. Insync begint dan altijd op
          "voorstellen", met een testset van echte voorbeelden van jouw kantoor. Pas als het
          aantoonbaar goed gaat, geef je meer ruimte.
        </p>
        <Button href="/contact" variant="outline" class="group">
          Bespreek je werk met ons
          <ArrowRight class="size-5 group-hover:translate-x-0.5 duration-150" />
        </Button>
      </div>
    </div>
  </section>

  <Cta
    heading="Benieuwd wat Insync bij jouw kantoor oppakt?"
    text="In een demo laten we zien hoe een gewone werkdag eruitziet met Insync, met jouw soort werk en jouw backoffice."
  />
</Layout>
