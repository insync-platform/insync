---
import Layout from "../layouts/Layout.astro";
import KlantLogos from "../components/site/KlantLogos.astro";

const faqs = [
  {
    "q": "Wie beslist er over een voorstel?",
    "a": "Standaard een medewerker: elk nieuw zaaktype begint op Voorstellen. Alleen wat jij per soort werk op Automatisch zet, gaat vanzelf, en een uitzondering gaat dan nog steeds naar een mens."
  },
  {
    "q": "Kan de AI zelf een betaling doen of een IBAN wijzigen?",
    "a": "Nee. Geld, IBAN en inloggegevens vallen onder de harde grens: daar beslist altijd een mens. Die grens is niet instelbaar, ook niet voor de klantassistent."
  },
  {
    "q": "Wat ziet de eigen AI-assistent van een klant?",
    "a": "Alleen de gegevens waarvoor de klant toestemming geeft, per soort. De klant kan die toestemming altijd intrekken. Geld, IBAN en account zijn nooit bereikbaar."
  },
  {
    "q": "Geeft Insync advies aan onze klanten?",
    "a": "Nee. Insync informeert en bereidt voor; advies geeft een medewerker. Vraagt een klant om advies, dan gaat de vraag naar je team."
  },
  {
    "q": "Kunnen we achteraf zien waarom iets automatisch ging?",
    "a": "Ja. In het verloop staat bijvoorbeeld: “Automatisch afgehandeld, volgens de doorlaatregeling zoals die gold op 3 okt.” Zo weet je ook later welke regel toen gold."
  }
];
---

<Layout
  title="Veiligheid en regie"
  description="Eerst een voorstel, dan een wijziging. Geld, IBAN en inloggegevens altijd via een mens. Alles is terug te vinden: wie, wanneer, waarom en onder welk beleid."
  faqs={faqs}
>
<main>

<!-- 1. Hero -->
<section data-hero aria-labelledby="kop-veiligheid" style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8vw, 88px) 24px 0; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">Veiligheid en regie</span>
<h1 id="kop-veiligheid" style="margin: 0; font-size: clamp(44px, 6.4vw, 92px); line-height: 1; font-weight: 500; letter-spacing: -0.045em">De AI doet het voorwerk. Jij houdt de regie.</h1>
<p style="margin: 0; font-size: 19px; line-height: 1.55; color: #52525B; max-width: 560px">Insync AI is het AI-platform voor verzekeraars, volmachten en adviseurs: de AI doet het voorwerk in je eigen backoffice, een mens beslist, en jij bepaalt hoeveel ruimte de AI krijgt.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href="/demo" style="background: #0A0A0A; color: #FFFFFF; text-decoration: none; font-weight: 500; font-size: 15px; padding: 12px 22px; border-radius: 999px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Demo inplannen</a>
<a href="/veiligheid#regie" style="border: 1px solid rgba(10,10,10,0.16); color: #0A0A0A; text-decoration: none; font-weight: 500; font-size: 15px; padding: 12px 22px; border-radius: 999px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Bekijk de zes beloftes</a>
</div>
</div>

<figure role="img" aria-label="Voorbeeld van een zaak in de werkbak: een klantvraag over bagage op wintersport. Bovenaan staat waarom de zaak bij jou ligt. Daaronder wat er gebeurt bij akkoord, en het blok Onderbouwing en bron met de passage uit de reisverzekering." style="flex: 1.1 1 500px; min-width: 0; margin: 0; position: relative; border-radius: 28px; background: #5B59F8; padding: clamp(16px, 4vw, 40px); box-sizing: border-box">
<span data-stamp style="position: absolute; top: -14px; right: clamp(16px, 4vw, 40px); display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; background: #C6F432; color: #0A0A0A; font-weight: 600; font-size: 15px; transform: rotate(-6deg); box-shadow: 0 8px 20px rgba(10,10,10,0.15)"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 7" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Akkoord</span>
<div style="border-radius: 16px; background: #FFFFFF; box-shadow: 0 24px 60px rgba(10,10,10,0.18); overflow: hidden">
<div style="display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid rgba(10,10,10,0.08)">
<span style="width: 10px; height: 10px; border-radius: 999px; background: rgba(10,10,10,0.12)"></span>
<span style="width: 10px; height: 10px; border-radius: 999px; background: rgba(10,10,10,0.12)"></span>
<span style="width: 10px; height: 10px; border-radius: 999px; background: rgba(10,10,10,0.12)"></span>
<span style="margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 3px 9px; border-radius: 999px; background: #F4F4F5; color: #52525B">Productie</span>
</div>
<div style="padding: 20px; display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A">Zaak 2026-1043</span>
<span style="font-size: 12px; font-weight: 500; padding: 3px 10px; border-radius: 999px; background: #FFEDD5; color: #9A3412">Nieuw</span>
<span style="font-size: 12px; padding: 3px 10px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.12); color: #3F3F46">Klantvraag</span>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<span style="font-size: 20px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.25">Is mijn bagage meeverzekerd op wintersport?</span>
<span style="font-size: 13px; color: #52525B">E-mail · P. Bakker · 12 min geleden</span>
</div>
<div style="display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: 12px; background: #ECECFE; color: #3F3DB8">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex: 0 0 auto; margin-top: 2px"><circle cx="12" cy="12" r="9" stroke="#3F3DB8" stroke-width="1.7"></circle><path d="M12 11v5M12 8h.01" stroke="#3F3DB8" stroke-width="1.8" stroke-linecap="round"></path></svg>
<span style="font-size: 13px; line-height: 1.45"><strong style="font-weight: 600">Waarom bij jou:</strong> het voorstel verstuurt een e-mail aan de klant. Dat is onomkeerbaar, dus een mens beslist.</span>
</div>
<div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(10,10,10,0.08)"><span style="font-size: 13px"><span style="color: #71717A">Bij akkoord:</span> e-mail aan klant · notitie in dossier</span><span style="font-size: 11px; font-weight: 500; padding: 3px 8px; border-radius: 999px; background: #FFEDD5; color: #9A3412; white-space: nowrap">Onomkeerbaar</span></div>
<div style="display: flex; flex-direction: column; gap: 10px; padding: 14px; border-radius: 12px; background: #FAFAFA; border: 1px solid rgba(10,10,10,0.06)">
<span style="font-size: 14px; font-weight: 600">Onderbouwing en bron</span>
<span style="font-size: 13px; line-height: 1.5; color: #3F3F46">Bagage is meeverzekerd tijdens wintersport. Ski's en snowboards vallen onder bagage.</span>
<div style="display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border-radius: 10px; background: #FFFFFF; border-left: 3px solid #5B59F8">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #71717A">Reisverzekering, art. 4.2 Bagage</span>
<span style="font-size: 13px; line-height: 1.5; color: #27272A">“Verzekerd is de bagage die verzekerde voor eigen gebruik meeneemt op reis, waaronder wintersportuitrusting.”</span>
</div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="font-size: 13px; font-weight: 500; padding: 8px 16px; border-radius: 999px; background: #0A0A0A; color: #FFFFFF">Akkoord</span>
<span style="font-size: 13px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.16); color: #27272A">Wijzigen</span>
<span style="font-size: 13px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.16); color: #27272A">Wegzetten</span>
</div>
</div>
</div>
</figure>
</section>

<!-- Klantenrij -->
<section aria-labelledby="kop-klanten" style="max-width: 1240px; margin: 0 auto; padding: 64px 24px 16px; display: flex; flex-direction: column; align-items: center; gap: 18px">
<h2 id="kop-klanten" style="margin: 0; font-size: 14px; font-weight: 400; color: #71717A">Vertrouwd door kantoren als</h2>
<KlantLogos size="lg" align="center" />
</section>

<!-- 2. Zes beloftes -->
<section id="regie" aria-labelledby="kop-regie" style="max-width: 1240px; margin: 0 auto; padding: 96px 24px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">01 / Regie</span>
<h2 id="kop-regie" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">Zes beloftes die in het product zitten</h2>
</div>
<p style="margin: 0; flex: 0 1 420px; min-width: 0; font-size: 18px; line-height: 1.55; color: #52525B">Geen afspraken op papier, maar regels die het platform zelf afdwingt.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px">

<article style="border-radius: 24px; background: #F4F4F5; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="width: 44px; height: 44px; border-radius: 14px; background: #ECECFE; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="2.5" stroke="#3F3DB8" stroke-width="1.6"></ellipse><path d="M5 6v12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" stroke="#3F3DB8" stroke-width="1.6"></path></svg></span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2">Je backoffice blijft de bron van waarheid</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Insync vervangt hem niet en leest vers vóór elke wijziging.</p>
</article>

<article style="border-radius: 24px; background: #F4F4F5; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="width: 44px; height: 44px; border-radius: 14px; background: #ECECFE; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3.5h7l4 4V19a1.5 1.5 0 01-1.5 1.5h-9A1.5 1.5 0 016 19V5a1.5 1.5 0 011-1.5z" stroke="#3F3DB8" stroke-width="1.6" stroke-linejoin="round"></path><path d="M9 13.5l2 2 4-4.5" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2">Eerst een voorstel, dan een effect</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Niets verandert in je backoffice zonder besluit. Ook niet vanuit de AI-assistent.</p>
</article>

<article style="border-radius: 24px; background: #F4F4F5; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="width: 44px; height: 44px; border-radius: 14px; background: #ECECFE; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5.5h14M5 10h9M5 14.5h6" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round"></path><circle cx="16.5" cy="17" r="3" stroke="#3F3DB8" stroke-width="1.6"></circle><path d="M18.7 19.2L20.5 21" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2">Geen akkoord zonder bron</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Elk voorstel toont waar het op rust: de mail, of de passage uit de voorwaarden.</p>
</article>

<article style="border-radius: 24px; background: #0A0A0A; color: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="width: 44px; height: 44px; border-radius: 14px; background: #C6F432; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" stroke="#0A0A0A" stroke-width="1.7"></rect><path d="M8 10.5V8a4 4 0 018 0v2.5" stroke="#0A0A0A" stroke-width="1.7" stroke-linecap="round"></path></svg></span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2">Een harde grens</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #A1A1AA">Geld, IBAN en inloggegevens gaan nooit vanzelf. Altijd een mens, en dat is niet instelbaar.</p>
</article>

<article style="border-radius: 24px; background: #F4F4F5; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="width: 44px; height: 44px; border-radius: 14px; background: #ECECFE; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 102.3-5.6" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round"></path><path d="M4 4.5v3.5h3.5" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 8v4.5l3 1.8" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2">Alles is terug te vinden</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Per zaak zie je wie wat deed, wanneer, waarom en onder welk beleid.</p>
</article>

<article style="border-radius: 24px; background: #F4F4F5; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="width: 44px; height: 44px; border-radius: 14px; background: #ECECFE; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16M7 20h10" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round"></path><path d="M5 7h14" stroke="#3F3DB8" stroke-width="1.6" stroke-linecap="round"></path><path d="M5 7l-2.5 6a2.5 2.5 0 005 0L5 7zM19 7l-2.5 6a2.5 2.5 0 005 0L19 7z" stroke="#3F3DB8" stroke-width="1.6" stroke-linejoin="round"></path></svg></span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2">Informeren, niet adviseren</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">De AI-beoordeling van een schade is voorwerk, met de badge “geen besluit”. De behandelaar beslist.</p>
</article>

</div>
</section>

<!-- 3. Wat mag de AI zelf? -->
<section id="harde-grens" aria-labelledby="kop-harde-grens" style="background: #FAFAFA; border-top: 1px solid rgba(10,10,10,0.06); border-bottom: 1px solid rgba(10,10,10,0.06)">
<div style="max-width: 1240px; margin: 0 auto; padding: 96px 24px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">02 / Harde grens</span>
<h2 id="kop-harde-grens" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">Wat mag de AI zelf?</h2>
</div>
<p style="margin: 0; flex: 0 1 420px; min-width: 0; font-size: 18px; line-height: 1.55; color: #52525B">Hoe zwaarder de gevolgen, hoe eerder een mens beslist. Geld blijft mensenwerk.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">

<article style="border-radius: 24px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.08); padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A">01</span>
<h3 style="margin: 0; font-size: 24px; font-weight: 500; letter-spacing: -0.02em">Lezen</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Een klant of polis opzoeken. Dit verandert niets.</p>
<span style="align-self: flex-start; margin-top: auto; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 999px; background: #DCFCE7; color: #166534">Gaat vanzelf</span>
</article>

<article style="border-radius: 24px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.08); padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A">02</span>
<h3 style="margin: 0; font-size: 24px; font-weight: 500; letter-spacing: -0.02em">Schrijven</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Een taak of notitie in je backoffice. Jij bepaalt of dit vanzelf mag.</p>
<span style="align-self: flex-start; margin-top: auto; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 999px; background: #ECECFE; color: #3F3DB8">Volgt jouw doorlaatregeling</span>
</article>

<article style="border-radius: 24px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.08); padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A">03</span>
<h3 style="margin: 0; font-size: 24px; font-weight: 500; letter-spacing: -0.02em">Onomkeerbaar</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Een e-mail aan een klant. Die krijg je niet terug, dus standaard beslist een mens.</p>
<span style="align-self: flex-start; margin-top: auto; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 999px; background: #FFEDD5; color: #9A3412">Standaard een mens</span>
</article>

<article style="border-radius: 24px; background: #0A0A0A; color: #FFFFFF; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #A1A1AA">04</span>
<h3 style="margin: 0; font-size: 24px; font-weight: 500; letter-spacing: -0.02em">Geld, IBAN, account</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #A1A1AA">Een betaling, een rekeningnummer, inloggegevens. Nooit vanzelf, niet instelbaar.</p>
<span style="align-self: flex-start; margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 999px; background: #C6F432; color: #0A0A0A"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" stroke="#0A0A0A" stroke-width="2"></rect><path d="M8 10.5V8a4 4 0 018 0v2.5" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"></path></svg>Altijd een mens</span>
</article>

</div>

<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; border-radius: 24px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.12); padding: 20px 24px">
<span style="font-size: 12px; font-weight: 500; padding: 4px 11px; border-radius: 999px; background: #C6F432; color: #0A0A0A">Voor je klanten</span>
<p style="margin: 0; flex: 1 1 480px; min-width: 0; font-size: 18px; line-height: 1.45; font-weight: 500; letter-spacing: -0.01em">Ook de klantassistent en de eigen AI van je klant kunnen nooit bij geld, IBAN of inloggegevens.</p>
</div>
</div>
</section>

<!-- 4. Middelste CTA-band -->
<section aria-labelledby="kop-cta-midden" style="max-width: 1240px; margin: 0 auto; padding: 96px 24px 0">
<div style="border-radius: 28px; background: #F4F4F5; padding: clamp(24px, 4vw, 40px) clamp(24px, 4vw, 48px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px">
<h2 id="kop-cta-midden" style="margin: 0; flex: 1 1 480px; min-width: 0; font-size: clamp(24px, 2.6vw, 32px); line-height: 1.2; font-weight: 500; letter-spacing: -0.025em">Zie in een demo hoe jij de regie houdt.</h2>
