---
import Layout from "../layouts/Layout.astro";
import Cta from "../components/sections/Cta.astro";
import Faq from "../components/sections/Faq.astro";
import PageHero from "../components/platform/PageHero.astro";
import SectionHeading from "../components/platform/SectionHeading.astro";
import Todo from "../components/platform/Todo.astro";
import {
  ClipboardCheck,
  SlidersHorizontal,
  Users,
  Lock,
  History,
  Check,
  Cpu,
} from "@lucide/astro";

const promises = [
  {
    icon: ClipboardCheck,
    title: "Eerst een voorstel, dan pas een wijziging.",
    text: "Insync wijzigt niets in je backoffice zonder voorstel. Je ziet vooraf precies wat er gebeurt.",
  },
  {
    icon: SlidersHorizontal,
    title: "Jij bepaalt wat vanzelf gaat.",
    text: 'Elk nieuw soort werk begint op "voorstellen". Meer ruimte geef je zelf, per soort werk, en je kunt het altijd terugdraaien.',
  },
  {
    icon: Users,
    title: "Vier ogen waar het telt.",
    text: "Boven een bedrag dat jij instelt, geeft een tweede collega akkoord. Eén medewerker telt als één handtekening.",
  },
  {
    icon: Lock,
    title: "Een harde grens.",
    text: "Betalingen, rekeningnummers en inloggegevens gaan nooit vanzelf, bij geen enkel kantoor en onder geen enkele instelling. Ook de AI-assistent zet die niet klaar: zo'n verzoek gaat naar een mens.",
  },
  {
    icon: History,
    title: "Alles is terug te vinden.",
    text: "Van elke zaak zie je wat er binnenkwam, wat Insync voorstelde en op basis waarvan, wie besliste, wanneer, waarom, en welke instelling op dat moment gold. Zo kun je het verloop uitleggen aan je klant, je accountant en de toezichthouder.",
  },
];

const dataPoints = [
  "Klant-, polis- en schadegegevens blijven in je eigen backoffice.",
  "Elk kantoor heeft een eigen afgeschermde omgeving.",
  "Je test eerst in een aparte testomgeving, los van je echte klanten.",
  "Insync ziet alleen wat nodig is voor de zaak die het voorbereidt.",
];

const faqs = [
  {
    q: "Beslist de AI over mijn klanten?",
    a: "Nee. De AI doet het voorwerk: zoeken, lezen, voorbereiden. Een medewerker beslist. Alleen wat jij uitdrukkelijk vrijgeeft, handelt Insync zelf af, en betalingen, rekeningnummers en inloggegevens nooit.",
  },
  {
    q: "Wat als Insync een fout maakt?",
    a: "Een voorstel is nog geen wijziging. Je medewerker ziet het voordat er iets gebeurt. Gaat er bij het uitvoeren iets mis, dan zie je dat in de zaak, en komt het bij een mens als het niet vanzelf opgelost kan worden.",
  },
  {
    q: "Kunnen we het eerst uitproberen?",
    a: 'Ja. Je begint in een aparte testomgeving, met echte voorbeelden van je eigen kantoor, en alles op "voorstellen".',
  },
];
---

<Layout
  title="Regie en vertrouwen"
  description="Eerst een voorstel, vier ogen waar het telt, een harde grens bij geld en rekeningnummers, en elke beslissing terug te vinden."
>
  <PageHero
    eyebrow="Regie en vertrouwen"
    title="Jij houdt de regie. Altijd."
    subtitle="Insync is gebouwd voor een vak met zorgplicht. Niets gebeurt zonder spoor, en niets gaat verder dan jij toestaat."
    secondary={{ href: "/platform", label: "Hoe het platform werkt" }}
  />

  <!-- Vijf afspraken -->
  <section class="pb-20 sm:pb-28">
    <div class="container">
      <SectionHeading eyebrow="Vijf afspraken" title="Waar je op kunt rekenen" />
      <div class="flex flex-wrap justify-center gap-5 max-w-6xl mx-auto">
        {
          promises.map((promise, i) => (
            <div
              class:list={[
                "w-full md:w-[calc(50%-0.625rem)] lg:w-[calc((100%-2.5rem)/3)] rounded-2xl border bg-white p-7 shadow-sm",
                promise.icon === Lock ? "border-primary/40 bg-primary/5" : "border-border/60",
              ]}
              data-aos="custom-fade-up"
              data-aos-duration="400"
              data-aos-delay={String(i * 80)}
              data-aos-once="true"
            >
              <div class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary mb-4">
                <promise.icon class="size-5" />
              </div>
              <h3 class="text-lg font-semibold mb-2">{promise.title}</h3>
              <p class="text-muted-foreground text-sm">{promise.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Gegevens -->
  <section class="py-20 sm:py-28 bg-muted/20 grain">
    <div class="container relative z-10">
      <div class="grid items-center gap-12 [&>*]:min-w-0 lg:grid-cols-2 max-w-6xl mx-auto">
        <div data-aos="custom-fade-up" data-aos-duration="400" data-aos-once="true">
          <span class="label mb-4 inline-block">Je gegevens</span>
          <h2>Je gegevens blijven waar ze horen</h2>
        </div>
        <ul class="space-y-3">
          {
            dataPoints.map((point, i) => (
              <li
                class="flex items-start gap-3 rounded-2xl border border-border/60 bg-white p-5 shadow-sm"
                data-aos="custom-fade-right"
                data-aos-duration="400"
                data-aos-delay={String(i * 80)}
                data-aos-once="true"
              >
                <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <Check class="size-4" />
                </span>
                <span class="font-medium">{point}</span>
              </li>
            ))
          }
          <li>
            <Todo>Hosting in de EU / verwerkersovereenkomst / certificeringen</Todo>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Over de AI -->
  <section class="py-20 sm:py-28">
    <div class="container">
      <div
        class="max-w-4xl mx-auto rounded-3xl bg-gradient-to-br from-primary via-rose to-accent p-[1.5px] shadow-sm shadow-primary/10"
        data-aos="custom-fade-up"
        data-aos-duration="400"
        data-aos-once="true"
      >
        <div class="rounded-[23px] bg-white p-8 sm:p-12">
          <div class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary mb-5">
            <Cpu class="size-5" />
          </div>
          <h2 class="h3 mb-5">De AI leest en stelt voor. Het platform beslist wat mag.</h2>
          <div class="space-y-4 text-lg text-muted-foreground">
            <p>
              Wat Insync zelf mag, staat niet in een instructie aan de AI. Het staat in de
              instellingen van je kantoor, en het platform controleert die bij elke stap. Daardoor
              gedraagt Insync zich voorspelbaar, ook als de AI zich vergist.
            </p>
            <p>
              Elke toepassing heeft een vaste set echte voorbeelden waarop we testen. Pas als die
              goed gaan, gaat een verandering live.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq heading="Goed om te weten" faqs={faqs} />

  <Cta
    heading="Zien hoe dat er in de praktijk uitziet?"
    text="In een demo laten we zien hoe een voorstel, een akkoord en het verloop van een zaak eruitzien, met jouw soort werk."
  />
</Layout>
