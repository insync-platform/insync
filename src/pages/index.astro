---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import CustomerPortalMockup from "../assets/customer-portal/mockup.webp";
import Background from "../assets/background.svg";
import LogoDuGardijn from "../assets/logos/du-gardijn.svg";
import LogoEfo from "../assets/logos/efo.svg";
import LogoJw from "../assets/logos/jw.svg";
import Button from "../components/ui/Button.astro";
import Cta from "../components/sections/Cta.astro";
import Faq from "../components/sections/Faq.astro";
import SectionHeading from "../components/platform/SectionHeading.astro";
import LayerCards from "../components/platform/LayerCards.astro";
import ProposalCard from "../components/platform/ProposalCard.astro";
import SoonBadge from "../components/platform/SoonBadge.astro";
import Todo from "../components/platform/Todo.astro";
import { stats, status, show } from "../data/platform";
import {
  ArrowRight,
  Mail,
  Search,
  Keyboard,
  FileSpreadsheet,
  ShieldCheck,
  Bot,
  LayoutDashboard,
  Building2,
  Plug,
  Check,
  Users,
} from "@lucide/astro";

const filledStats = stats.filter((stat) => stat.value);

const painPoints = [
  {
    icon: Mail,
    text: "Werk komt binnen via mail, telefoon, portaal en de backoffice, en niemand ziet alles.",
  },
  { icon: Search, text: "Elke medewerker zoekt dezelfde gegevens opnieuw op." },
  {
    icon: Keyboard,
    text: "Het meeste werk is voorspelbaar, maar het kost toch elke keer handwerk.",
  },
];

const useCases = [
  {
    icon: FileSpreadsheet,
    title: "Borderellen en totalen",
    text: "Klopt het, dan sluit de zaak vanzelf. Wijkt het af, dan staat er een taak met het verschil in je backoffice.",
  },
  {
    icon: Mail,
    title: "Klantvragen per mail",
    text: "Een conceptantwoord op basis van het dossier en de voorwaarden, klaar om te versturen.",
  },
  {
    icon: ShieldCheck,
    title: "Schademeldingen",
    text: "Komt binnen via het klantportaal, compleet en met de relevante voorwaarden erbij.",
  },
  {
    icon: Bot,
    title: "AI-assistent",
    text: "Voor alles wat niet in een vast patroon past: tijdens een telefoongesprek, bij een lastige dekkingsvraag, of om voorwaarden te vergelijken.",
  },
];

const routes = [
  {
    icon: LayoutDashboard,
    title: "In de werkomgeving van Insync",
    text: "De werkbak en de AI-assistent, in één omgeving voor je hele team.",
    soon: false,
  },
  {
    icon: Building2,
    title: "In je eigen backoffice",
    text: "Insync zet zijn werk klaar als taak in je backoffice. Je team hoeft Insync niet te openen.",
    soon: false,
    extra: "Of in een paneel naast je dossier.",
    extraSoon: status.embeddedPanel === "soon",
  },
  {
    icon: Plug,
    title: "Via een koppeling",
    text: "Werk je met eigen software of een partner? Dan vraag je zaken aan en volg je ze via een koppeling.",
    soon: status.api === "soon",
  },
];

const controlPoints = [
  "Elke wijziging is eerst een voorstel, met de bron erbij.",
  "Boven een bedrag dat jij kiest, kijkt een tweede collega mee.",
  "Geld, rekeningnummers en inloggegevens gaan nooit vanzelf. Dat is geen instelling, dat zit in het fundament.",
  "Elke beslissing is terug te vinden: wie, wanneer, waarom, en onder welke instelling.",
];

const faqs = [
  {
    q: "Vervangt Insync onze backoffice?",
    a: "Nee. Insync werkt bovenop je backoffice. Je gegevens blijven daar, en je team kan er gewoon in blijven werken.",
  },
  {
    q: "Moet mijn team in een nieuw systeem gaan werken?",
    a: "Dat hoeft niet. Insync kan zijn werk ook als taak in je backoffice klaarzetten. Wil je alles op één plek, dan is er de werkbak.",
  },
  {
    q: "Beslist de AI over mijn klanten?",
    a: "Nee. De AI doet het voorwerk: zoeken, lezen, voorbereiden. Een medewerker beslist. Alleen wat jij uitdrukkelijk vrijgeeft, handelt Insync zelf af, en betalingen, rekeningnummers en inloggegevens nooit.",
  },
  {
    q: "Wat als Insync een fout maakt?",
    a: "Een voorstel is nog geen wijziging. Je medewerker ziet het voordat er iets gebeurt. Gaat er bij het uitvoeren iets mis, dan zie je dat in de zaak, en komt het bij een mens als het niet vanzelf opgelost kan worden.",
  },
  {
    q: "Kunnen we het eerst uitproberen?",
    a: 'Ja. Je begint in een aparte testomgeving, met echte voorbeelden van je eigen kantoor, en alles op "voorstellen".',
  },
];
---

<Layout
  title="Het AI-platform voor verzekeringskantoren"
  description="Insync bereidt het werk van je kantoor voor in je eigen backoffice. De AI doet het voorwerk, jouw team beslist. Minder handwerk, meer tijd voor klanten."
>
  <!-- Hero -->
  <section id="hero" class="relative pt-28 sm:pt-36 2xl:pt-44 pb-20 sm:pb-28 overflow-hidden">
    <div
      class="absolute inset-x-0 top-0 h-svh -z-10"
      style="mask-image: linear-gradient(to bottom, black 60%, transparent);"
      aria-hidden="true"
    >
      <img
        src={Background.src}
        alt=""
        class="w-full h-full object-cover starting:opacity-0 starting:scale-120 transition-[opacity,scale] duration-2000 delay-800"
      />
    </div>

    <div class="container">
      <div class="grid items-center gap-14 [&>*]:min-w-0 lg:grid-cols-[1.15fr_1fr]">
        <div class="text-center lg:text-left">
          <h1
            class="display mb-6 starting:opacity-0 starting:translate-y-8 transition-all duration-800 delay-100"
          >
            Het werk is al
            <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-primary via-rose to-accent bg-[length:200%_auto] animate-[gradient-shift_6s_ease_infinite]"
              >voorbereid</span
            >. Jij geeft akkoord.
          </h1>
          <p
            class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto lg:mx-0 mb-10 starting:opacity-0 starting:translate-y-8 transition-all duration-800 delay-200"
          >
            Insync verzamelt al het werk van je kantoor op één plek, bereidt het voor in je eigen
            backoffice en handelt af wat jij vrijgeeft. Minder overtypen, minder zoeken, meer tijd
            voor je klanten.
          </p>
          <div
            class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4 starting:opacity-0 starting:translate-y-8 transition-all duration-800 delay-300"
          >
            <Button href="/demo" size="lg" class="glow-primary" data-umami-event="Demo CTA">
              Demo inplannen
              <ArrowRight class="size-5" />
            </Button>
            <Button href="/platform" size="lg" variant="outline">Bekijk hoe het werkt</Button>
          </div>
          <p
            class="mt-6 text-sm text-muted-foreground starting:opacity-0 transition-opacity duration-800 delay-500"
          >
            Werkt bovenop je bestaande backoffice. We vervangen 'm niet, we maken 'm slimmer.
          </p>
        </div>

        <div
          class="flex justify-center lg:justify-end starting:opacity-0 starting:translate-y-10 transition-all duration-1000 delay-400"
        >
          <ProposalCard class="animate-float" />
        </div>
      </div>
    </div>

    <div class="container mt-20 sm:mt-28">
      <div
        class="flex flex-col items-center"
        data-aos="custom-fade-up"
        data-aos-duration="400"
        data-aos-once="true"
      >
        <p class="text-sm font-medium text-muted-foreground mb-8">Kantoren die met Insync werken</p>
        <div class="flex items-center justify-center gap-12 sm:gap-20">
          <a href="https://dugardijn.nl" target="_blank">
            <img
              src={LogoDuGardijn.src}
              alt="Du Gardijn"
              class="h-10 sm:h-12 opacity-60 hover:opacity-100 transition-opacity duration-300"
            />
          </a>
          <a href="https://efo.nl" target="_blank">
            <img
              src={LogoEfo.src}
              alt="EFO Verzekeringen"
              class="h-10 sm:h-12 opacity-60 hover:opacity-100 transition-opacity duration-300"
            />
          </a>
          <a href="https://jw.nl" target="_blank">
            <img
              src={LogoJw.src}
              alt="JW"
              class="h-10 sm:h-12 opacity-60 hover:opacity-100 transition-opacity duration-300"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Het probleem -->
  <section id="probleem" class="py-24 sm:py-32 grain relative overflow-hidden">
    <div class="container relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <div
          class="lg:w-1/2 text-center lg:text-left"
          data-aos="custom-fade-up"
          data-aos-duration="400"
          data-aos-once="true"
        >
          <h2 class="display !text-[2.25rem] sm:!text-[3rem] lg:!text-[3.5rem] mb-6">
            Je team is druk. Maar <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-primary to-accent"
              >met wat</span
            >?
          </h2>
          <p class="text-lg sm:text-xl text-muted-foreground max-w-xl mx-auto lg:mx-0">
            Een groot deel van de dag gaat niet naar advies of klantcontact. Het gaat naar mail
            doorlezen, gegevens opzoeken, overtypen in de backoffice, borderellen naast de
            administratie leggen en schademeldingen compleet maken.
          </p>
        </div>

        <div class="lg:w-1/2 w-full">
          <ul class="space-y-3">
            {
              painPoints.map((point, i) => (
                <li
                  class="flex items-start gap-4 rounded-2xl border border-border/60 bg-muted/60 p-5"
                  data-aos="custom-fade-right"
                  data-aos-duration="400"
                  data-aos-delay={String(150 + i * 100)}
                  data-aos-once="true"
                >
                  <point.icon class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
                  <span class="font-medium">{point.text}</span>
                </li>
              ))
            }
          </ul>
          <p
            class="mt-6 rounded-2xl border border-primary/30 bg-linear-to-br from-primary/15 via-primary/10 to-accent/10 p-5 font-medium"
            data-aos="custom-rise-pop"
            data-aos-duration="600"
            data-aos-delay="550"
            data-aos-once="true"
          >
            Dat werk kan anders. Niet door er nog een systeem naast te zetten, maar door het voor te
            bereiden waar je al werkt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Drie lagen -->
  <section id="drie-lagen" class="py-20 sm:py-28">
    <div class="container">
      <SectionHeading
        eyebrow="Het platform"
        title="Eén platform, drie lagen"
        intro="Insync is gebouwd rond één idee: de AI doet het voorwerk, de mens beslist, en jij bepaalt hoeveel ruimte de AI krijgt."
      />
      <LayerCards links />
      <div class="mt-12 text-center">
        <Button href="/platform" variant="outline" class="group">
          Meer over de drie lagen
          <ArrowRight class="size-5 group-hover:translate-x-0.5 duration-150" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Tijdwinst -->
  <section id="tijdwinst" class="py-20 sm:py-28 bg-muted/20 grain">
    <div class="container relative z-10">
      <SectionHeading
        eyebrow="Tijdwinst"
        title="Tijd terug voor het werk dat ertoe doet"
        intro="Insync haalt het handwerk weg rond werk dat elke dag terugkomt. Wat overblijft is het moment waarop jouw kennis nodig is: even kijken, akkoord geven, of bijsturen."
      />
      {
        filledStats.length > 0 && (
          <div class="grid gap-5 sm:grid-cols-3 max-w-5xl mx-auto mb-10">
            {filledStats.map((stat) => (
              <div class="rounded-2xl border border-border/60 bg-white p-7 text-center shadow-sm">
                <div class="font-headings text-4xl font-semibold text-primary mb-2">
                  {stat.value}
                </div>
                <div class="text-sm text-muted-foreground">{stat.label}</div>
              </div>
            ))}
          </div>
        )
      }
      {
        filledStats.length === 0 && (
          <div class="mb-8 text-center">
            <Todo>Cijfers tijdwinst invullen in src/data/platform.ts</Todo>
          </div>
        )
      }
      <p class="max-w-2xl mx-auto text-center text-muted-foreground">
        Insync meet per zaak wat er is gebeurd. Je ziet dus in je eigen omgeving hoeveel werk
        vanzelf ging en hoeveel tijd dat scheelde.
      </p>
    </div>
  </section>

  <!-- Toepassingen -->
  <section id="toepassingen" class="py-20 sm:py-28">
    <div class="container">
      <SectionHeading eyebrow="Toepassingen" title="Wat Insync vandaag voor je oppakt" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 max-w-6xl mx-auto">
        {
          useCases.map((item, i) => (
            <div
              class="rounded-2xl border border-border/60 bg-white p-6 shadow-sm"
              data-aos="custom-fade-up"
              data-aos-duration="400"
              data-aos-delay={String(i * 80)}
              data-aos-once="true"
            >
              <div class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary mb-4">
                <item.icon class="size-5" />
              </div>
              <h3 class="text-lg font-semibold mb-1.5">{item.title}</h3>
              <p class="text-muted-foreground text-sm">{item.text}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <Button href="/toepassingen" variant="outline" class="group">
          Alle toepassingen
          <ArrowRight class="size-5 group-hover:translate-x-0.5 duration-150" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Drie manieren -->
  <section id="manieren" class="py-20 sm:py-28 bg-muted/20 grain">
    <div class="container relative z-10">
      <SectionHeading
        eyebrow="Geen overstap nodig"
        title="Werk zoals je kantoor al werkt"
        intro="Niet elk kantoor wil een nieuw scherm. Dat hoeft ook niet."
      />
      <div class="grid gap-5 md:grid-cols-3 max-w-6xl mx-auto">
        {
          routes.map((route, i) => (
            <div
              class="flex flex-col rounded-3xl border border-border/60 bg-white p-7 shadow-sm"
              data-aos="custom-fade-up"
              data-aos-duration="400"
              data-aos-delay={String(i * 100)}
              data-aos-once="true"
            >
              <div class="mb-4 flex items-center justify-between gap-3">
                <div class="flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <route.icon class="size-5" />
                </div>
                {route.soon && <SoonBadge />}
              </div>
              <h3 class="text-lg font-semibold mb-1.5">{route.title}</h3>
              <p class="text-muted-foreground text-sm">{route.text}</p>
              {route.extra && (
                <p class="mt-3 text-sm text-muted-foreground">
                  {route.extra} {route.extraSoon && <SoonBadge class="ml-1" />}
                </p>
              )}
            </div>
          ))
        }
      </div>
      <p class="mt-10 max-w-2xl mx-auto text-center font-medium">
        Welke route je ook kiest: hetzelfde voorwerk, dezelfde instellingen, dezelfde
        verantwoording.
      </p>
      <div class="mt-8 text-center">
        <Button href="/zo-werk-je-ermee" variant="outline" class="group">
          Zo werk je ermee
          <ArrowRight class="size-5 group-hover:translate-x-0.5 duration-150" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Regie -->
  <section id="regie" class="py-20 sm:py-28">
    <div class="container">
      <div class="grid items-center gap-12 [&>*]:min-w-0 lg:grid-cols-2 max-w-6xl mx-auto">
        <div data-aos="custom-fade-up" data-aos-duration="400" data-aos-once="true">
          <span class="label mb-4 inline-block">Regie</span>
          <h2 class="mb-4">De AI doet het voorwerk. Jouw mensen beslissen.</h2>
          <p class="text-lg text-muted-foreground mb-8">
            In een vak met zorgplicht moet je kunnen uitleggen wat er gebeurd is. Daarom is Insync
            zo gebouwd dat er niets gebeurt zonder spoor.
          </p>
          <Button href="/regie" variant="outline" class="group">
            Meer over regie en vertrouwen
            <ArrowRight class="size-5 group-hover:translate-x-0.5 duration-150" />
          </Button>
        </div>
        <ul class="space-y-3">
          {
            controlPoints.map((point, i) => (
              <li
                class="flex items-start gap-3 rounded-2xl border border-border/60 bg-white p-5 shadow-sm"
                data-aos="custom-fade-right"
                data-aos-duration="400"
                data-aos-delay={String(i * 100)}
                data-aos-once="true"
              >
                <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <Check class="size-4" />
                </span>
                <span class="font-medium">{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Klantportaal -->
  <section id="klanten" class="py-20 sm:py-28 bg-muted/20 grain">
    <div class="container relative z-10">
      <div
        class="grid items-center gap-10 lg:grid-cols-2 max-w-6xl mx-auto rounded-3xl border border-border/60 bg-white p-7 sm:p-12 shadow-sm overflow-hidden"
        data-aos="custom-fade-up"
        data-aos-duration="400"
        data-aos-once="true"
      >
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span
              class="inline-flex items-center justify-center size-9 rounded-lg bg-rose/10 text-rose"
            >
              <Users class="size-5" />
            </span>
            <span class="label !text-rose">Ook voor je klanten</span>
          </div>
          <h2 class="h3 mb-4">Makkelijker verzekeren, aan beide kanten</h2>
          <p class="text-muted-foreground mb-6">
            Wat je kantoor sneller maakt, merkt je klant ook. Via het white-label klantportaal zien
            klanten hun polissen en documenten, melden ze een schade en stellen ze vragen, in de
            huisstijl van jouw kantoor. Wat daar binnenkomt, staat voorbereid in je werkbak.
          </p>
          <Button href="/oplossingen/klantportaal" variant="outline" class="group">
            Bekijk het klantportaal
            <ArrowRight class="size-5 group-hover:translate-x-0.5 duration-150" />
          </Button>
        </div>
        <Image
          src={CustomerPortalMockup}
          alt="Het klantportaal van Insync op een telefoon en laptop"
          class="w-full h-auto"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 560px, 100vw"
        />
      </div>
    </div>
  </section>

  {
    show.quote && (
      <section class="py-20 sm:py-28">
        <div class="container">
          <figure class="max-w-3xl mx-auto text-center">
            <blockquote class="font-headings text-2xl sm:text-3xl font-medium leading-snug mb-6">
              "{show.quote.text}"
            </blockquote>
            <figcaption class="text-muted-foreground">
              {show.quote.name}, {show.quote.role} bij {show.quote.company}
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <Faq heading="Goed om te weten" faqs={faqs} />

  <Cta
    heading="Benieuwd wat Insync bij jouw kantoor oppakt?"
    text="In een demo laten we zien hoe een gewone werkdag eruitziet met Insync, met jouw soort werk en jouw backoffice."
  />
</Layout>
