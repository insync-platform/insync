---
import Layout from "../layouts/Layout.astro";
import Sketch from "../components/site/Sketch.astro";
import PhotoMockup from "../components/site/PhotoMockup.astro";
import FloatCard from "../components/site/FloatCard.astro";
import portaalReisFoto from "../assets/customer-portal/mockup-airplane.webp";
import KlantLogos from "../components/site/KlantLogos.astro";

const faqs = [
  {
    "q": "Werkt Insync met onze backoffice?",
    "a": "Insync draait live op Novulo en koppelt met je Microsoft 365-mailbox. Met ANVA en CCS is de koppeling getest; die zetten we op met de testomgeving van jouw kantoor. Het klantportaal gebruikt dezelfde koppeling."
  },
  {
    "q": "Wat is het klantportaal?",
    "a": "Een portaal in je eigen huisstijl waar klanten zelf regelen, schade melden en online afsluiten. Je neemt het los af, of als uitbreiding van Insync AI: dan komt wat je klanten regelen als voorbereide zaak in je werkbak. Bekijk het klantportaal →"
  },
  {
    "q": "Wie beslist er over een voorstel?",
    "a": "Een medewerker, tenzij je kantoor voor dat soort werk iets anders heeft ingesteld in de doorlaatregeling. Elk nieuw zaaktype begint op Voorstellen: dan beslist altijd een mens."
  },
  {
    "q": "Wat kost Insync?",
    "a": "Dat hangt af van de zaaktypes die je aanzet en het volume. In de demo maken we een voorstel dat bij je kantoor past."
  },
  {
    "q": "Hoe snel zijn we live?",
    "a": "Je begint op je testomgeving met één zaaktype, bijvoorbeeld verzoeken per mail, en zet het daarna op productie. Je klantportaal kan binnen een week live staan."
  },
  {
    "q": "Hoe zit het met geld en IBAN?",
    "a": "Betalingen, rekeningnummers en inloggegevens gaan nooit vanzelf. Daar beslist altijd een mens, en die grens is niet instelbaar. Ook een AI-assistent die je klant zelf koppelt, kan er nooit bij."
  }
];
---

<Layout
  fullTitle="Insync – AI-platform voor adviseurs, volmachten en verzekeraars"
  description="Insync doet het voorwerk in je eigen backoffice, voor je team én je klanten. Een mens beslist, en jij bepaalt hoeveel ruimte de AI krijgt."
  faqs={faqs}
  software
>
<main>

<!-- 1. Hero -->
<section data-hero aria-labelledby="hero-kop" style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) 24px 0; display: flex; flex-direction: column; align-items: center; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; max-width: 980px">
<a href="/insync-ai" style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(10,10,10,0.12); border-radius: 999px; padding: 6px 14px; font-size: 13px; color: #52525B; text-decoration: none"><span style="width: 8px; height: 8px; border-radius: 999px; background: #5B59F8"></span>Insync AI · voor adviseurs, volmachten en verzekeraars</a>
<h1 id="hero-kop" style="margin: 0; font-size: clamp(44px, 6.4vw, 92px); line-height: 1; font-weight: 500; letter-spacing: -0.045em">Het voorwerk is al gedaan.</h1>
<p style="margin: 0; font-size: clamp(17px, 1.5vw, 19px); line-height: 1.55; color: #52525B; max-width: 720px">Insync AI is het AI-platform voor adviseurs, volmachten en verzekeraars: de AI doet het voorwerk in je eigen backoffice, een mens beslist, en jij bepaalt hoeveel ruimte de AI krijgt.</p>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; padding-top: 8px">
<a href="/demo" style="background: #0A0A0A; color: #FFFFFF; text-decoration: none; font-weight: 500; font-size: 15px; padding: 12px 22px; border-radius: 999px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Demo inplannen</a>
<a href="/insync-ai" style="border: 1px solid rgba(10,10,10,0.16); color: #0A0A0A; text-decoration: none; font-weight: 500; font-size: 15px; padding: 12px 22px; border-radius: 999px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Bekijk Insync AI</a>
</div>
</div>

<figure aria-label="Productbeeld: de werkbak van Insync AI met zaken uit e-mail en het klantportaal, en een voorstel voor een klantvraag waarop akkoord is gegeven" style="margin: 0; width: 100%; border-radius: 28px; background: #5B59F8; padding: clamp(16px, 5vw, 64px) clamp(12px, 4.5vw, 64px) 0; box-sizing: border-box; overflow: hidden">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: center; row-gap: 24px">

<div style="flex: 1 1 620px; min-width: 0; margin-bottom: -16px; border-radius: 16px; background: #FFFFFF; box-shadow: 0 24px 60px rgba(10,10,10,0.20); overflow: hidden">
<div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid rgba(10,10,10,0.08)">
<div style="display: flex; gap: 8px"><span style="width: 10px; height: 10px; border-radius: 999px; background: rgba(10,10,10,0.12)"></span><span style="width: 10px; height: 10px; border-radius: 999px; background: rgba(10,10,10,0.12)"></span><span style="width: 10px; height: 10px; border-radius: 999px; background: rgba(10,10,10,0.12)"></span></div>

</div>
<div style="padding: clamp(14px, 2vw, 24px) clamp(14px, 2vw, 24px) 40px; background: #FAFAFA; display: flex; flex-direction: column; gap: 18px">
<span style="font-size: 20px; font-weight: 600; letter-spacing: -0.02em">Werkbak</span>

<div style="display: flex; flex-wrap: wrap-reverse; gap: 16px; align-items: stretch">

<div style="flex: 1.7 1 520px; min-width: 0; border-radius: 14px; border: 1px solid rgba(10,10,10,0.08); background: #FFFFFF; overflow-x: auto">
<div class="wb-table" style="min-width: 560px">
<div class="wb-head" style="display: grid; grid-template-columns: 124px 100px minmax(0, 1fr) 124px; gap: 12px; padding: 10px 16px; border-bottom: 1px solid rgba(10,10,10,0.08); font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">
<span>Type</span><span>Klant</span><span>Omschrijving</span><span>Status</span>
</div>
<div class="wb-row" style="display: grid; grid-template-columns: 124px 100px minmax(0, 1fr) 124px; gap: 12px; align-items: center; padding: 14px 16px; border-bottom: 1px solid rgba(10,10,10,0.06); background: #F4F4F5; font-size: 14px">
<span style="font-weight: 500">Verzoek</span><span style="color: #3F3F46">Jansen B.V.</span><span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">Verhuist per 1 november · raakt 3 polissen</span><span><span style="font-size: 12px; font-weight: 500; padding: 3px 9px; border-radius: 999px; background: #FFEDD5; color: #9A3412; white-space: nowrap">Nieuw</span></span>
</div>
<div class="wb-row" style="display: grid; grid-template-columns: 124px 100px minmax(0, 1fr) 124px; gap: 12px; align-items: center; padding: 14px 16px; border-bottom: 1px solid rgba(10,10,10,0.06); font-size: 14px">
<span style="font-weight: 500; display: inline-flex; align-items: center; gap: 6px">Schademelding<span title="Urgent" style="width: 7px; height: 7px; border-radius: 999px; background: #DC2626"></span></span><span style="color: #3F3F46">M. de Vries</span><span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">Waterschade keuken · via het klantportaal · AI-beoordeling klaar</span><span><span style="font-size: 12px; font-weight: 500; padding: 3px 9px; border-radius: 999px; background: #FFEDD5; color: #9A3412; white-space: nowrap">Nieuw</span></span>
</div>
<div class="wb-row" style="display: grid; grid-template-columns: 124px 100px minmax(0, 1fr) 124px; gap: 12px; align-items: center; padding: 14px 16px; border-bottom: 1px solid rgba(10,10,10,0.06); font-size: 14px">
<span style="font-weight: 500">Expertiserapport</span><span style="color: #3F3F46">De Wit Bouw</span><span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">Rapport naast de polis gelegd · onderverzekering 12%</span><span><span style="font-size: 12px; font-weight: 500; padding: 3px 9px; border-radius: 999px; background: #ECECFE; color: #3F3DB8; white-space: nowrap">Opgepakt</span></span>
</div>
<div class="wb-row" style="display: grid; grid-template-columns: 124px 100px minmax(0, 1fr) 124px; gap: 12px; align-items: center; padding: 14px 16px; font-size: 14px">
<span style="font-weight: 500">Rappel</span><span style="color: #3F3F46">K. Visser</span><span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis">Schadefactuur ontbreekt na 14 dagen · herinnering verstuurd</span><span><span style="font-size: 12px; font-weight: 500; padding: 3px 9px; border-radius: 999px; background: #DCFCE7; color: #166534; white-space: nowrap">Afgehandeld</span></span>
</div>
</div>
</div>

<div style="position: relative; flex: 1 1 320px; min-width: 0; border-radius: 14px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.08); box-shadow: 0 16px 40px rgba(10,10,10,0.14); padding: 20px; box-sizing: border-box; display: flex; flex-direction: column; gap: 14px">
<span data-stamp aria-hidden="true" style="position: absolute; top: -14px; right: 18px; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; background: #C6F432; color: #0A0A0A; font-weight: 600; font-size: 15px; transform: rotate(-6deg); box-shadow: 0 8px 20px rgba(10,10,10,0.15)"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 7" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>Akkoord</span>
<div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-right: 110px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">Verzoek</span>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<span style="font-size: 18px; font-weight: 500; line-height: 1.3; letter-spacing: -0.01em">Jansen B.V. verhuist per 1 november</span>
<span style="font-size: 13px; color: #71717A">E-mail · 3 polissen bij 2 maatschappijen</span>
</div>
<div style="border-radius: 10px; border: 1px solid rgba(10,10,10,0.08); overflow: hidden">
<div style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border-bottom: 1px solid rgba(10,10,10,0.06);"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="flex: 0 0 auto"><path d="M3 7.2l2.6 2.6L11 4.4" stroke="#166534" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span style="display: flex; flex-direction: column; gap: 1px; min-width: 0"><span style="font-size: 13px; font-weight: 500">Bedrijfsaansprakelijkheid</span><span style="font-size: 12px; line-height: 1.4; color: #52525B">Adres wijzigen</span></span></div>
<div style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border-bottom: 1px solid rgba(10,10,10,0.06);"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="flex: 0 0 auto"><path d="M3 7.2l2.6 2.6L11 4.4" stroke="#166534" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span style="display: flex; flex-direction: column; gap: 1px; min-width: 0"><span style="font-size: 13px; font-weight: 500">Bedrijfsauto's</span><span style="font-size: 12px; line-height: 1.4; color: #52525B">Adres wijzigen</span></span></div>
<div style="display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px;"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="flex: 0 0 auto"><circle cx="7" cy="7" r="5.6" stroke="#9A3412" stroke-width="1.4"></circle><path d="M7 4.2v3.4" stroke="#9A3412" stroke-width="1.4" stroke-linecap="round"></path><circle cx="7" cy="9.9" r="0.8" fill="#9A3412"></circle></svg><span style="display: flex; flex-direction: column; gap: 1px; min-width: 0"><span style="font-size: 13px; font-weight: 500">Inventaris en goederen</span><span style="font-size: 12px; line-height: 1.4; color: #52525B">Nieuw pand in andere premiezone. Bouwaard onbekend: vraag aan klant klaargezet.</span></span></div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="font-size: 14px; font-weight: 500; padding: 8px 16px; border-radius: 999px; background: #0A0A0A; color: #FFFFFF">Akkoord</span>
<span style="font-size: 14px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.16); color: #27272A">Wijzigen</span>
</div>
</div>

</div>
</div>
</div>

</div>
</figure>
</section>

<!-- 2. Klantenrij -->
<section aria-labelledby="klanten-kop" style="max-width: 1240px; margin: 0 auto; padding: 56px 24px 24px; display: flex; flex-direction: column; align-items: center; gap: 20px">
<h2 id="klanten-kop" style="margin: 0; font-size: 14px; font-weight: 400; color: #71717A">Live bij</h2>
<KlantLogos size="lg" align="center" />
</section>

<!-- 3. Het platform in drie lagen -->
<section id="platform" aria-labelledby="platform-kop" style="max-width: 1240px; margin: 0 auto; padding: 104px 24px 96px; display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">01 / Insync AI</span>
<h2 id="platform-kop" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">Het platform in drie lagen</h2>
</div>
<p style="margin: 0; flex: 0 1 400px; min-width: 0; font-size: 18px; line-height: 1.55; color: #52525B">Insync AI werkt bovenop je backoffice. Werk komt binnen in de werkbak, elke wijziging loopt via de actielaag, en de doorlaatregeling bepaalt wat vanzelf mag.</p>
</div>

<div style="display: flex; flex-wrap: wrap; gap: 16px">

<article aria-labelledby="laag-werkbak" style="flex: 2 1 560px; min-width: 0; border-radius: 24px; background: #0A0A0A; color: #FFFFFF; padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 18px; box-sizing: border-box">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #C6F432">01 · Werkbak</span>
<h3 id="laag-werkbak" style="margin: 0; font-size: 30px; font-weight: 500; letter-spacing: -0.02em">Alles op één plek, al voorbereid</h3>
<p style="margin: 0; font-size: 17px; line-height: 1.5; color: #A1A1AA; max-width: 480px">Uit elk kanaal één stroom, en bij elk item het voorstel en de bron waar het op rust.</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.16); color: #E4E4E7">E-mail</span>
<span style="font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.16); color: #E4E4E7">AI-assistent</span>
<span style="font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.16); color: #E4E4E7">API</span>
<span style="font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.16); color: #E4E4E7">Signalen</span>
<span style="font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.16); color: #E4E4E7">Klantportaal</span>
</div>
<div style="flex: 1 1 auto; display: flex; align-items: center; padding: 12px 0"><Sketch kind="inflow" tone="dark" max="480px" /></div>
<a href="/insync-ai#werkbak" style="align-self: flex-start; font-weight: 500; font-size: 15px; text-decoration: none; color: #FFFFFF">Meer over de werkbak →</a>
</article>

<div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px">

<article aria-labelledby="laag-actielaag" style="flex: 1 1 auto; border-radius: 24px; background: #F4F4F5; padding: clamp(24px, 3vw, 32px); display: flex; flex-direction: column; gap: 14px; box-sizing: border-box">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #3F3DB8">02 · Actielaag</span>
<h3 id="laag-actielaag" style="margin: 0; font-size: 24px; font-weight: 500; letter-spacing: -0.02em">Eerst een voorstel, dan pas een wijziging</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Insync voert uit na een besluit en laat zien of het gelukt is.</p>
<div style="padding: 8px 0"><Sketch kind="steps" max="320px" /></div>
<a href="/insync-ai#actielaag" style="align-self: flex-start; font-weight: 500; font-size: 15px; text-decoration: none; color: #3F3DB8">Meer over de actielaag →</a>
</article>

<article aria-labelledby="laag-doorlaat" style="flex: 1 1 auto; border-radius: 24px; background: #5B59F8; color: #FFFFFF; padding: clamp(24px, 3vw, 32px); display: flex; flex-direction: column; gap: 14px; box-sizing: border-box">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #FFFFFF">03 · Doorlaatregeling</span>
<h3 id="laag-doorlaat" style="margin: 0; font-size: 24px; font-weight: 500; letter-spacing: -0.02em">Jij bepaalt wat vanzelf mag</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #FFFFFF">Per soort werk. Elk besluit is te verantwoorden: wie, wanneer, waarom en onder welk beleid.</p>
<div style="padding: 8px 0"><Sketch kind="dial" tone="indigo" max="320px" /></div>
<a href="/insync-ai#doorlaatregeling" style="align-self: flex-start; font-weight: 500; font-size: 15px; text-decoration: none; color: #FFFFFF">Meer over de doorlaatregeling →</a>
</article>

</div>
</div>

<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 32px; padding: 24px 0 0; border-top: 1px solid rgba(10,10,10,0.08)">
<p style="margin: 0; flex: 1 1 520px; min-width: 0; font-size: 17px; line-height: 1.55; color: #52525B"><span style="color: #0A0A0A; font-weight: 500">Daarnaast: de AI-assistent.</span> Voor werk zonder vaste vorm, zoals een telefoongesprek of een lastige dekkingsvraag, in chat of met spraak. Wat de assistent wil wijzigen, wordt ook een voorstel.</p>
<a href="/insync-ai#ai-assistent" style="font-weight: 500; font-size: 15px; text-decoration: none; color: #5B59F8">Meer over de AI-assistent →</a>
</div>
</section>

<!-- 4. Hoe werkt het? -->
<section id="hoe-het-werkt" aria-labelledby="hoe-kop" style="background: #FAFAFA; border-top: 1px solid rgba(10,10,10,0.06); border-bottom: 1px solid rgba(10,10,10,0.06)">
<div style="max-width: 1240px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">02 / Hoe werkt het?</span>
<h2 id="hoe-kop" style="margin: 0; max-width: 860px; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">Van binnenkomend werk tot uitgevoerd, in drie stappen</h2>
<p style="margin: 0; max-width: 580px; font-size: 18px; line-height: 1.55; color: #52525B">Insync bereidt voor, jij beslist. Pas daarna verandert er iets in je backoffice.</p>
</div>

<ol class="feature-grid" style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px">

<li class="feature-card" style="border-radius: 24px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.08); padding: 12px; display: flex; flex-direction: column; min-width: 0">
<div aria-hidden="true" style="border-radius: 16px; background: #F4F4F5; padding: 16px; min-height: 252px; box-sizing: border-box; display: flex; flex-direction: column; gap: 8px">
<Sketch kind="inflow" max="300px" />
</div>
<div style="padding: 20px 12px 12px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #3F3DB8">STAP 1</span>
<h3 style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.02em">Er komt werk binnen</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Een mail in je gekoppelde Microsoft 365-mailbox, een melding uit het klantportaal, een opdracht aan de AI-assistent of een verzoek via de API. Insync herkent wat voor zaak het is.</p>
<ul aria-label="Bronnen" style="margin: 0; padding: 2px 0 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px">
<li style="font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #F4F4F5; color: #3F3F46">E-mail</li>
<li style="font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #F4F4F5; color: #3F3F46">Klantportaal</li>
<li style="font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #F4F4F5; color: #3F3F46">AI-assistent</li>
<li style="font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #F4F4F5; color: #3F3F46">API</li>
</ul>
</div>
</li>

<li class="feature-card" style="border-radius: 24px; background: #FFFFFF; border: 1px solid rgba(10,10,10,0.08); padding: 12px; display: flex; flex-direction: column; min-width: 0">
<div aria-hidden="true" style="border-radius: 16px; background: #F4F4F5; padding: 16px; min-height: 252px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center">
<Sketch kind="prepare" max="300px" />
