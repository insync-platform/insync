---
import Layout from "../layouts/Layout.astro";
import Sketch from "../components/site/Sketch.astro";
import PhotoMockup from "../components/site/PhotoMockup.astro";
import FloatCard from "../components/site/FloatCard.astro";
import portaalFoto from "../assets/customer-portal/mockup.webp";
import afsluitenFoto from "../assets/insurance-portal/car-insurance-mockup.webp";
import KlantLogos from "../components/site/KlantLogos.astro";

const faqs = [
  {
    "q": "Kan het portaal in onze eigen huisstijl?",
    "a": "Ja. Logo, kleuren, letters en hoeken stel je zelf in, net als teksten, FAQ, formulieren, schadeflows en de tone of voice van de assistent. Daar is geen developer voor nodig, en een wijziging staat direct live."
  },
  {
    "q": "Hebben klanten een wachtwoord nodig?",
    "a": "Nee. Klanten loggen in met een magic link: een inloglink die ze per e-mail krijgen. Geen wachtwoord om te vergeten, en dus ook geen vragen over een nieuw wachtwoord."
  },
  {
    "q": "Zien klanten actuele gegevens?",
    "a": "Ja. Het portaal haalt polissen, documenten en facturen realtime uit je backoffice. Je backoffice blijft de bron van waarheid."
  },
  {
    "q": "Hoe melden klanten schade?",
    "a": "In eigen woorden, in het portaal of via de klantassistent. De wizard vraagt alleen wat nog ontbreekt en leest een geüpload schadeformulier uit. Met Insync AI komt de melding als zaak met AI-beoordeling in de werkbak, en ziet je klant de status terug in het portaal."
  },
  {
    "q": "Moeten we ook Insync AI afnemen?",
    "a": "Nee. Het portaal werkt ook los; inzendingen gaan dan per e-mail of naar je eigen systeem. Neem je Insync AI erbij, dan komt alles als voorbereide zaak in de werkbak van je team en is het rondje rond."
  }
];
---

<Layout
  title="Klantportaal"
  description="Je klant regelt het zelf, 24/7: polissen inzien, schade melden met AI, wijzigen en online afsluiten. In je eigen huisstijl, zelf beheerd."
  faqs={faqs}
>
<main>

<!-- 1. Hero -->
<section data-hero aria-labelledby="hero-kop" style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) 24px 0; display: flex; flex-direction: column; align-items: center; gap: 56px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; max-width: 980px">
<span style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(10,10,10,0.12); border-radius: 999px; padding: 6px 14px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #52525B; text-transform: uppercase; letter-spacing: 0.08em"><span style="width: 8px; height: 8px; border-radius: 999px; background: #C6F432; box-shadow: 0 0 0 1px rgba(10,10,10,0.12)"></span>Klantportaal · los of samen met Insync AI</span>
<h1 id="hero-kop" style="margin: 0; font-size: clamp(44px, 6.4vw, 92px); line-height: 1; font-weight: 500; letter-spacing: -0.045em">Je klant regelt het zelf. Jij houdt de regie.</h1>
<p style="margin: 0; font-size: clamp(17px, 1.5vw, 19px); line-height: 1.55; color: #27272A; max-width: 700px">Een portaal in je eigen huisstijl. Je klanten bekijken hun polissen, melden schade, stellen vragen aan een assistent die hun dossier kent en sluiten online af. Dag en nacht, rechtstreeks op je backoffice.</p>
<p style="margin: 0; font-size: 16px; line-height: 1.55; color: #52525B; max-width: 700px">Neem het portaal los af, of samen met <a href="/insync-ai" style="color: #3F3DB8; font-weight: 500; text-decoration: none">Insync AI</a>: dan komt wat je klanten zelf regelen als voorbereide zaak in je werkbak.</p>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; padding-top: 8px">
<a href="/demo" style="background: #0A0A0A; color: #FFFFFF; text-decoration: none; font-weight: 500; font-size: 15px; padding: 12px 22px; border-radius: 999px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Demo inplannen</a>
<a href="/klantportaal#online-afsluiten" style="border: 1px solid rgba(10,10,10,0.16); color: #0A0A0A; text-decoration: none; font-weight: 500; font-size: 15px; padding: 12px 22px; border-radius: 999px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Bekijk online afsluiten</a>
</div>
</div>

<PhotoMockup
  src={portaalFoto}
  alt="Een klant bekijkt het klantportaal op haar telefoon: het startscherm met verzekeringen, facturen, schade melden en contact."
  ratio="16 / 9"
  ratioSm="4 / 3"
  focus="40% 45%"
  sizes="(max-width: 1240px) 100vw, 1192px"
  loading="eager"
  style="width: 100%"
>
<FloatCard place="top-right" order={0} width="320px" style="--top: 40px; --right: 40px">
<div class="fc-meta"><span>Klantassistent</span><span>22:14</span></div>
<span class="fc-bubble-me">Is mijn fiets gedekt bij diefstal?</span>
<span class="fc-bubble-ai">Ja, via je inboedelverzekering ook buitenshuis, tot € 2.000.</span>
<span class="fc-source"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 1.75h5.5L12.25 4.5v9.75H4z" stroke="#3F3DB8" stroke-width="1.5" stroke-linejoin="round"></path><path d="M6 8h4.5M6 10.75h4.5" stroke="#3F3DB8" stroke-width="1.5" stroke-linecap="round"></path></svg>Inboedelverzekering, art. 3.4</span>
</FloatCard>
<FloatCard place="bottom-right" order={1} width="340px" style="--bottom: 40px; --right: 72px">
<div class="fc-row"><span class="fc-icon" style="background: #C6F432"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.8C8 1.8 3.5 6.6 3.5 9.6a4.5 4.5 0 009 0C12.5 6.6 8 1.8 8 1.8z" stroke="#0A0A0A" stroke-width="1.5" stroke-linejoin="round"></path></svg></span><span style="display: flex; flex-direction: column; min-width: 0"><span class="fc-title">Waterschade keuken</span><span class="fc-sub">Schademelding · gisteren</span></span><span class="fc-badge" style="background: #ECECFE; color: #3F3DB8">In behandeling</span></div>
</FloatCard>
</PhotoMockup>
<p style="margin: -32px 0 0; font-size: 13px; color: #52525B; text-align: center">Je klant vraagt, meldt en volgt alles zelf, ook buiten kantoortijden. Jouw portaal draagt jouw merk.</p>
</section>

<!-- 2. Klantenrij -->
<section aria-labelledby="klanten-kop" style="max-width: 1240px; margin: 0 auto; padding: 56px 24px 24px; display: flex; flex-direction: column; align-items: center; gap: 20px">
<h2 id="klanten-kop" style="margin: 0; font-size: 14px; font-weight: 400; color: #71717A">Live bij</h2>
<KlantLogos only={["EFO Verzekeringen", "JW"]} size="lg" align="center" />
<p style="margin: 0; font-size: 14px; color: #52525B; text-align: center">Het klantportaal draait hier live, inclusief de klantassistent.</p>
</section>

<!-- 3. 24/7 zelf regelen -->
<section id="zelf-regelen" aria-labelledby="zelf-kop" style="max-width: 1240px; margin: 0 auto; padding: 104px 24px 96px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">01 / Zelf regelen</span>
<h2 id="zelf-kop" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">Alles over hun verzekeringen, 24/7 bij de hand</h2>
</div>
<div style="flex: 0 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<p style="margin: 0; font-size: 18px; line-height: 1.55; color: #52525B">Wat je klant zelf kan inzien en regelen, komt niet meer binnen als vraag per mail of telefoon.</p>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Het polisblad staat er gewoon. Ook op zondagavond.</p>
</div>
</div>

<ul style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px">
<li style="border-radius: 24px; background: #F4F4F5; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<span aria-hidden="true" style="width: 40px; height: 40px; border-radius: 12px; background: #C6F432; display: inline-flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2.5l6 2.2v4.6c0 3.9-2.6 6.6-6 8.2-3.4-1.6-6-4.3-6-8.2V4.7z" stroke="#0A0A0A" stroke-width="1.6" stroke-linejoin="round"></path><path d="M7.3 10l2 2 3.6-3.8" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
<h3 style="margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.02em">Polissen en dekking</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Polissen, dekkingen, premie en voorwaarden inzien, met de actuele stand uit je backoffice.</p>
</li>
<li style="border-radius: 24px; background: #F4F4F5; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<span aria-hidden="true" style="width: 40px; height: 40px; border-radius: 12px; background: #C6F432; display: inline-flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5.5 2.5h6l3 3v12h-9z" stroke="#0A0A0A" stroke-width="1.6" stroke-linejoin="round"></path><path d="M8 10h4.5M8 13h4.5" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
<h3 style="margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.02em">Documenten en facturen</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Polisbladen, voorwaarden en facturen bekijken en downloaden, wanneer het je klant uitkomt.</p>
</li>
<li style="border-radius: 24px; background: #F4F4F5; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<span aria-hidden="true" style="width: 40px; height: 40px; border-radius: 12px; background: #C6F432; display: inline-flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M12.5 3.5l4 4L7 17H3v-4z" stroke="#0A0A0A" stroke-width="1.6" stroke-linejoin="round"></path></svg></span>
<h3 style="margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.02em">Wijzigingen doorgeven</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Een nieuw adres, een ander kenteken of een andere dekking, met de gewenste ingangsdatum.</p>
</li>
<li style="border-radius: 24px; background: #F4F4F5; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<span aria-hidden="true" style="width: 40px; height: 40px; border-radius: 12px; background: #C6F432; display: inline-flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="#0A0A0A" stroke-width="1.6"></circle><path d="M7.5 7.5l5 5M12.5 7.5l-5 5" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
<h3 style="margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.02em">Opzeggen</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Een polis opzeggen gaat in een paar stappen, zonder brief of telefoontje.</p>
</li>
<li style="border-radius: 24px; background: #F4F4F5; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<span aria-hidden="true" style="width: 40px; height: 40px; border-radius: 12px; background: #C6F432; display: inline-flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3.2" stroke="#0A0A0A" stroke-width="1.6"></circle><path d="M3.8 17c.8-3 3.3-4.6 6.2-4.6s5.4 1.6 6.2 4.6" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
<h3 style="margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.02em">Gegevens beheren</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Persoons- en bedrijfsgegevens zelf bijwerken. Zakelijke klanten zien hun relaties netjes gegroepeerd.</p>
</li>
<li style="border-radius: 24px; background: #F4F4F5; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<span aria-hidden="true" style="width: 40px; height: 40px; border-radius: 12px; background: #C6F432; display: inline-flex; align-items: center; justify-content: center"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 13.5V9a5 5 0 0110 0v4.5l1.5 2h-13z" stroke="#0A0A0A" stroke-width="1.6" stroke-linejoin="round"></path><path d="M8.3 17.5a1.8 1.8 0 003.4 0" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round"></path></svg></span>
<h3 style="margin: 0; font-size: 20px; font-weight: 500; letter-spacing: -0.02em">Meldingen naar keuze</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #52525B">Je klant kiest per categorie waarover hij bericht krijgt. Niet meer, niet minder.</p>
</li>
</ul>

<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding-top: 8px; border-top: 1px solid rgba(10,10,10,0.08)">
<span style="font-size: 15px; color: #52525B; padding-top: 16px">Voor particuliere én zakelijke klanten</span>
<span style="display: flex; flex-wrap: wrap; gap: 8px; padding-top: 16px">
<span style="font-size: 13px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.12); color: #27272A">Particulier</span>
<span style="font-size: 13px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.12); color: #27272A">Zakelijk, met meerdere relaties</span>
<span style="font-size: 13px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.12); color: #27272A">Inloggen zonder wachtwoord</span>
<span style="font-size: 13px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(10,10,10,0.12); color: #27272A">Nederlands en Engels</span>
</span>
</div>
</section>

<!-- 4. Schade melden met AI -->
<section id="schade-melden" aria-labelledby="schade-kop" style="background: #FAFAFA; border-top: 1px solid rgba(10,10,10,0.06); border-bottom: 1px solid rgba(10,10,10,0.06)">
<div style="max-width: 1240px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 48px">

<div style="display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 64px); align-items: center">
<div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #71717A; text-transform: uppercase; letter-spacing: 0.08em">02 / Schade melden</span>
<h2 id="schade-kop" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">Schade melden in eigen woorden</h2>
<p style="margin: 0; font-size: 18px; line-height: 1.55; color: #52525B">Je klant vertelt wat er gebeurde, zoals hij het ook aan de telefoon zou doen. De wizard begrijpt het verhaal en vraagt alleen nog wat ontbreekt.</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
<li style="display: flex; gap: 10px; align-items: flex-start; font-size: 16px; line-height: 1.5"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="flex: 0 0 auto; margin-top: 2px"><circle cx="10" cy="10" r="9" stroke="#0A0A0A" stroke-width="1.5"></circle><path d="M6 10.2l2.6 2.6L14 7.4" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Alleen de vragen die bij deze schade horen</li>
<li style="display: flex; gap: 10px; align-items: flex-start; font-size: 16px; line-height: 1.5"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="flex: 0 0 auto; margin-top: 2px"><circle cx="10" cy="10" r="9" stroke="#0A0A0A" stroke-width="1.5"></circle><path d="M6 10.2l2.6 2.6L14 7.4" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Een ingevuld schadeformulier wordt uitgelezen, dus niets dubbel typen</li>
<li style="display: flex; gap: 10px; align-items: flex-start; font-size: 16px; line-height: 1.5"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" style="flex: 0 0 auto; margin-top: 2px"><circle cx="10" cy="10" r="9" stroke="#0A0A0A" stroke-width="1.5"></circle><path d="M6 10.2l2.6 2.6L14 7.4" stroke="#0A0A0A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>Halverwege stoppen kan: het concept blijft bewaard</li>
</ul>
<p style="margin: 0; font-size: 15px; line-height: 1.55; color: #52525B">Jouw team krijgt een complete melding, in plaats van een mail met drie vervolgvragen.</p>
</div>

<figure aria-label="Productbeeld: schade melden in het portaal van Polder Verzekeringen. De klant beschrijft een lekkende vaatwasser, de wizard herkent waterschade, stelt nog één vraag en leest het schadeformulier uit." style="flex: 1.15 1 440px; min-width: 0; margin: 0; border-radius: 28px; background: #F4F4F5; border: 1px solid rgba(10,10,10,0.06); padding: clamp(20px, 4vw, 48px) clamp(12px, 3vw, 40px); box-sizing: border-box; display: flex; justify-content: center">
<div style="flex: 1 1 300px; max-width: 390px; min-width: 0; border-radius: 36px; background: #0A0A0A; padding: 9px; box-sizing: border-box; box-shadow: 0 24px 50px rgba(10,10,10,0.18)">
<div style="border-radius: 28px; background: #FFFFFF; overflow: hidden; display: flex; flex-direction: column; color: #0A0A0A">
<div aria-hidden="true" style="display: flex; justify-content: space-between; align-items: center; padding: 14px 24px 8px; font-size: 13px; font-weight: 600"><span>9:41</span><span style="width: 84px; height: 24px; border-radius: 999px; background: #0A0A0A"></span><svg width="44" height="12" viewBox="0 0 44 12" fill="none"><rect x="0" y="7" width="3" height="5" rx="1" fill="#0A0A0A"></rect><rect x="5" y="5" width="3" height="7" rx="1" fill="#0A0A0A"></rect><rect x="10" y="3" width="3" height="9" rx="1" fill="#0A0A0A"></rect><rect x="15" y="1" width="3" height="11" rx="1" fill="#0A0A0A"></rect><rect x="23.5" y="1.5" width="17" height="9" rx="2.5" stroke="#0A0A0A"></rect><rect x="25.5" y="3.5" width="11" height="5" rx="1" fill="#0A0A0A"></rect></svg></div>
<div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 20px 14px; border-bottom: 1px solid rgba(10,10,10,0.06)">
<span style="display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4l-6 6 6 6" stroke="#0A0A0A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>Schade melden</span>
<span style="display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #52525B"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="#0F766E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>Concept bewaard</span>
</div>
<div style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 14px; background: #FAFAFA">
<div style="display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 13px; font-weight: 500; color: #3F3F46">Vertel in je eigen woorden wat er gebeurde</span>
<div style="border-radius: 14px; background: #FFFFFF; border: 1.5px solid #0F766E; padding: 12px 14px; font-size: 14px; line-height: 1.5; color: #0A0A0A">Zaterdagavond is de vaatwasser gaan lekken. De keukenvloer en het kastje eronder zijn helemaal nat.</div>
</div>
<div style="border-radius: 14px; background: #F0FDFA; border: 1px solid rgba(15,118,110,0.20); padding: 12px 14px; display: flex; flex-direction: column; gap: 8px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #0F766E; letter-spacing: 0.08em">BEGREPEN</span>
<div style="display: flex; flex-wrap: wrap; gap: 6px">
<span style="font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #FFFFFF; color: #27272A; border: 1px solid rgba(10,10,10,0.08)">Waterschade</span>
<span style="font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #FFFFFF; color: #27272A; border: 1px solid rgba(10,10,10,0.08)">Keuken</span>
<span style="font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #FFFFFF; color: #27272A; border: 1px solid rgba(10,10,10,0.08)">3 oktober</span>
<span style="font-size: 12px; padding: 3px 9px; border-radius: 999px; background: #FFFFFF; color: #27272A; border: 1px solid rgba(10,10,10,0.08)">Woonhuisverzekering</span>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #71717A; letter-spacing: 0.08em">NOG ÉÉN VRAAG</span>
<span style="font-size: 15px; font-weight: 500">Is de lekkage gestopt?</span>
<div style="display: flex; gap: 8px">
