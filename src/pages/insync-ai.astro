---
import Layout from "../layouts/Layout.astro";
import KlantLogos from "../components/site/KlantLogos.astro";

const faqs = [
  {
    "q": "Werkt Insync AI met onze backoffice?",
    "a": "Insync AI werkt bovenop backoffices als Novulo, ANVA en CCS, en koppelt met je Microsoft 365-mailbox. Je backoffice blijft de bron van waarheid; Insync vervangt niets."
  },
  {
    "q": "Wie beslist over een voorstel?",
    "a": "Een medewerker. Alleen wat je kantoor in de doorlaatregeling zelf op Steekproef of Automatisch zet, gaat vanzelf. Elk zaaktype begint op Voorstellen."
  },
  {
    "q": "Wat gaat er nooit vanzelf?",
    "a": "Geld, IBAN en inloggegevens. Daar beslist altijd een mens, en die grens is niet in te stellen. Ook een mail aan een klant en een schade-uitkering gaan altijd langs een medewerker."
  },
  {
    "q": "Wat kost Insync AI?",
    "a": "Dat hangt af van de zaaktypes die je gebruikt en het volume. In de demo maken we een voorstel dat past bij jouw kantoor."
  },
  {
    "q": "Hoe snel zijn we live?",
    "a": "Je begint op je testomgeving met één zaaktype, bijvoorbeeld verzoeken per mail. Werkt dat zoals je wilt, dan zet je het op productie en voeg je het volgende soort werk toe."
  }
];
---

<Layout
  title="Insync AI"
  description="De werkbak, de actielaag en de doorlaatregeling: Insync AI bereidt elke zaak voor in je eigen backoffice. Jij beslist, Insync voert uit."
  faqs={faqs}
  software
>
<main>

<!-- 1. Hero -->
<section data-hero aria-labelledby="hero-kop" style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) 24px 0; display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px 56px">
