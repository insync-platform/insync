---
// A mock-up of one prepared case as an employee sees it. Fictitious data only.
import { Mail, NotebookPen, ListChecks, FileText, Check, Pencil } from "@lucide/astro";

const { class: className = "" } = Astro.props;

const actions = [
  { icon: Mail, title: "Conceptantwoord aan M. de Vries", detail: "Ja, je bagage is meeverzekerd tot €3.000 …" },
  { icon: NotebookPen, title: "Notitie in het dossier", detail: "Vraag over dekking bagage, beantwoord" },
  { icon: ListChecks, title: "Taak voor Sanne", detail: "Reisverzekering uitbreiden met wintersport" },
];

const sources = ["Mail van 7 okt", "Polisvoorwaarden art. 4.2", "Dossier"];
---

<div
  class:list={[
    "relative w-full max-w-md rounded-2xl border border-border/60 bg-white text-left shadow-xl shadow-primary/10",
    className,
  ]}
>
  <div class="flex items-center justify-between gap-3 border-b px-5 py-4">
    <div>
      <div class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
        Klantvraag · per mail
      </div>
      <div class="mt-1 font-semibold">M. de Vries · Reisverzekering</div>
    </div>
    <span class="rounded-full bg-warning/10 px-2.5 py-1 text-xs font-semibold text-warning-dark"
      >Wacht op jou</span
    >
  </div>

  <div class="space-y-4 px-5 py-4">
    <div>
      <div class="mb-1 text-xs font-semibold text-muted-foreground">Wat er speelt</div>
      <p class="text-sm">Klant vraagt of zijn bagage is meeverzekerd tijdens een skivakantie.</p>
    </div>

    <div>
      <div class="mb-2 text-xs font-semibold text-muted-foreground">Voorstel</div>
      <ul class="space-y-2">
        {
          actions.map((action) => (
            <li class="flex gap-3 rounded-xl bg-muted/70 px-3 py-2.5">
              <action.icon class="mt-0.5 size-4 shrink-0 text-primary" />
              <div class="min-w-0">
                <div class="text-sm font-medium">{action.title}</div>
                <div class="truncate text-xs text-muted-foreground">{action.detail}</div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <div class="mb-2 text-xs font-semibold text-muted-foreground">Bron</div>
      <div class="flex flex-wrap gap-1.5">
        {
          sources.map((source) => (
            <span class="inline-flex items-center gap-1 rounded-md border px-2 py-0.5 text-xs text-muted-foreground">
              <FileText class="size-3" />
              {source}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-2 border-t px-5 py-4">
    <span
      class="inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-sm font-medium"
      aria-hidden="true"
    >
      <Pencil class="size-4" /> Wijzigen
    </span>
    <span
      class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground"
      aria-hidden="true"
    >
      <Check class="size-4" /> Akkoord
    </span>
  </div>
</div>
