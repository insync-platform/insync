---
const columns = [
  {
    title: "Insync AI",
    links: [
      { href: "/insync-ai#werkbak", label: "Werkbak" },
      { href: "/insync-ai#ai-assistent", label: "AI-assistent" },
      { href: "/insync-ai#doorlaatregeling", label: "Doorlaatregeling" },
      { href: "/insync-ai#zaaktypes", label: "Zaaktypes" },
    ],
  },
  {
    title: "Uitbreiden",
    links: [
      { href: "/klantportaal#zelf-regelen", label: "Klantportaal" },
      { href: "/klantportaal#schade-melden", label: "Schade melden" },
      { href: "/klantportaal#klantassistent", label: "Klantassistent" },
      { href: "/klantportaal#online-afsluiten", label: "Online afsluiten" },
    ],
  },
  {
    title: "Insync",
    links: [
      { href: "/integraties", label: "Integraties" },
      { href: "/veiligheid", label: "Veiligheid en regie" },
      { href: "https://docs.insync.insure", label: "Docs hub" },
      { href: "/blog", label: "Blog" },
      { href: "/demo", label: "Contact en demo" },
    ],
  },
