---
import LogoDuGardijn from "../../assets/logos/du-gardijn.svg";
import LogoEfo from "../../assets/logos/efo.svg";
import LogoJw from "../../assets/logos/jw.svg";

interface Props {
  size?: "lg" | "sm";
  align?: "center" | "start";
  labelledby?: string;
  /** Alleen deze klanten tonen (op naam). */
  only?: string[];
}

const { size = "lg", align = "center", labelledby, only } = Astro.props;

const alle = [
  { name: "du Gardijn", href: "/blog/eerste-klanten-live", logo: LogoDuGardijn, scale: 1 },
  { name: "EFO Verzekeringen", href: "/blog/klantportaal-efo-live", logo: LogoEfo, scale: 1.15 },
  { name: "JW", href: "/blog/klantportaal-jw-live", logo: LogoJw, scale: 0.8 },
];
const klanten = only ? alle.filter((k) => only.includes(k.name)) : alle;
---

<ul class:list={["klant-logos", `klant-logos--${size}`, `klant-logos--${align}`]} aria-labelledby={labelledby}>
  {
    klanten.map((k) => (
      <li>
        <a href={k.href} title={`Lees hoe ${k.name} met Insync werkt`} style={`--s: ${k.scale}`}>
          <img src={k.logo.src} alt={k.name} width={k.logo.width} height={k.logo.height} loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>
