          <rect class="k-ink" x="224" y="176" width="94" height="16" rx="8" />
        </g>
      </g>
    )
  }

  {
    kind === "brands" && (
      <g>
        <g class="pop" style="--dd: 0ms">
          <rect class="k-card" x="52" y="24" width="112" height="192" rx="24" />
          <rect x="68" y="44" width="16" height="16" rx="5" fill="#0F766E" />
          <rect class="k-bar" x="90" y="49" width="44" height="6" rx="3" />
