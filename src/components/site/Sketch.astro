          <rect class="k-acc" x="232" y="92" width="62" height="6" rx="3" />
          <rect class="k-tint" x="224" y="114" width="94" height="22" rx="7" />
          <rect class="k-acc" x="232" y="122" width="36" height="6" rx="3" />
          <rect class="k-card" x="224" y="144" width="94" height="22" rx="7" />
