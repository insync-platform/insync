          <rect class="k-card" x="286" y="148" width="36" height="28" rx="6" />
          <rect class="k-bar" x="294" y="157" width="20" height="4" rx="2" />
          <rect class="k-bar" x="294" y="165" width="14" height="4" rx="2" />
