  {
    kind === "trail" && (
      <g>
        <path class="k-line draw" d="M80 40 V200" pathLength="1" />
        {[46, 88, 130, 172].map((y, i) => (
          <g class="pop" style={`--dd: ${200 + i * 220}ms`}>
            <circle class:list={[i === 2 ? "k-lime" : i === 3 ? "k-acc" : "k-card"]} cx="80" cy={y} r="7" />
            <rect class="k-bar-strong" x="104" y={y - 8} width={[150, 120, 170, 132][i]} height="7" rx="3.5" />
            <rect class="k-bar" x="104" y={y + 4} width={[96, 80, 110, 70][i]} height="5" rx="2.5" />
