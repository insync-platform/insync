        </g>
        <path class="k-line draw" d="M46 74 q8 -6 16 0 t16 0 t16 0 t16 0 t16 0 t16 0" pathLength="1" style="--dd: 300ms" />
        <path class="k-line draw" d="M46 92 q8 -6 16 0 t16 0 t16 0 t16 0 t16 0" pathLength="1" style="--dd: 500ms" />
        <path class="k-line draw" d="M46 110 q8 -6 16 0 t16 0 t16 0" pathLength="1" style="--dd: 700ms" />
