---
/**
 * Abstracte lijntekeningen als vervanging voor drukke productbeelden.
 * Dunne lijnen, een enkel indigo of limoen accent, nauwelijks tekst.
 * Lijnen met `draw` tekenen zich in als de tekening in beeld komt (motion.ts).
 *
 * tone: "light" op een licht vlak, "dark" op zwart, "indigo" op het merkvlak.
 */
interface Props {
  kind:
    | "inflow"
    | "prepare"
    | "decide"
    | "dial"
    | "steps"
    | "review"
    | "chat"
    | "compare"
    | "apps"
    | "agents"
    | "phone"
    | "trail"
    | "vault"
    | "form"
    | "brands";
  tone?: "light" | "dark" | "indigo";
  max?: string;
}

const { kind, tone = "light", max = "420px" } = Astro.props;

const inflowPaths = [
  "M62 48 C130 48 128 124 190 124",
  "M62 96 C126 96 130 124 190 124",
  "M62 144 C126 144 130 124 190 124",
  "M62 192 C130 192 128 124 190 124",
];
const risk = Array.from({ length: 10 }, (_, i) => i);
const rows = [70, 92, 114, 136, 158];
---

<svg
  class:list={["sketch", `sketch--${tone}`]}
  viewBox="0 0 360 240"
  aria-hidden="true"
  focusable="false"
  style={`--sketch-max: ${max}`}
  data-sketch
>
  {
    kind === "inflow" && (
      <g>
        {inflowPaths.map((d, i) => (
          <path class="k-line draw" d={d} pathLength="1" style={`--dd: ${i * 120}ms`} />
        ))}
        <rect class="k-card" x="28" y="34" width="28" height="28" rx="8" />
        <path class="k-line" d="M34 43 L42 49 L50 43" />
        <rect class="k-acc" x="28" y="82" width="28" height="28" rx="14" />
        <circle class="k-paper" cx="42" cy="96" r="4" />
        <rect class="k-card" x="28" y="130" width="28" height="28" rx="8" />
        <rect class="k-bar" x="35" y="140" width="14" height="3" rx="1.5" />
        <rect class="k-bar" x="35" y="146" width="10" height="3" rx="1.5" />
        <rect class="k-lime" x="28" y="178" width="28" height="28" rx="8" />
        <circle class="k-ink" cx="42" cy="192" r="3.5" />

        <rect class="k-card pop" x="204" y="60" width="116" height="100" rx="14" opacity="0.45" style="--dd: 500ms" />
        <rect class="k-card pop" x="197" y="67" width="128" height="104" rx="14" opacity="0.75" style="--dd: 600ms" />
        <g class="pop" style="--dd: 700ms">
          <rect class="k-card" x="190" y="74" width="140" height="108" rx="14" />
          <rect class="k-bar-strong" x="206" y="92" width="64" height="8" rx="4" />
          <rect class="k-bar" x="206" y="110" width="104" height="6" rx="3" />
          <rect class="k-bar" x="206" y="122" width="84" height="6" rx="3" />
          <rect class="k-tint" x="206" y="148" width="50" height="16" rx="8" />
          <circle class="k-acc" cx="216" cy="156" r="3" />
          <circle class="k-lime" cx="306" cy="156" r="9" />
          <path class="k-check" d="M301.5 156 l3 3 l6 -6.5" />
        </g>
        <g class="movers">
          {inflowPaths.map((d, i) => (
            <circle class="k-acc" r="3.5">
              <animateMotion dur="3.2s" begin={`${i * 0.8}s`} repeatCount="indefinite" path={d} />
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.15;0.8;1" dur="3.2s" begin={`${i * 0.8}s`} repeatCount="indefinite" />
            </circle>
          ))}
        </g>
      </g>
    )
  }

  {
    kind === "prepare" && (
      <g>
        <g class="pop" style="--dd: 0ms">
          <path class="k-card" d="M40 40 H120 L146 66 V202 H40 Z" />
          <path class="k-line" d="M120 40 V66 H146" />
          <rect class="k-bar" x="54" y="82" width="70" height="6" rx="3" />
          <rect class="k-bar" x="54" y="96" width="78" height="6" rx="3" />
          <rect class="k-bar" x="54" y="110" width="58" height="6" rx="3" />
          <rect class="k-acc" x="54" y="132" width="78" height="10" rx="5" />
          <rect class="k-bar" x="54" y="156" width="70" height="6" rx="3" />
          <rect class="k-bar" x="54" y="170" width="50" height="6" rx="3" />
        </g>
        <path class="k-line draw" d="M136 137 C172 137 170 100 206 100" pathLength="1" style="--dd: 300ms" />
        <circle class="k-acc pop" cx="206" cy="100" r="4" style="--dd: 900ms" />
        <g class="pop" style="--dd: 700ms">
          <rect class="k-card" x="210" y="60" width="116" height="124" rx="14" />
          <rect class="k-bar-strong" x="224" y="78" width="62" height="8" rx="4" />
          <rect class="k-bar" x="224" y="96" width="88" height="6" rx="3" />
          <rect class="k-bar" x="224" y="108" width="72" height="6" rx="3" />
          <rect class="k-tint" x="224" y="126" width="70" height="16" rx="8" />
          <circle class="k-acc" cx="234" cy="134" r="3" />
          <rect class="k-ink" x="224" y="156" width="42" height="14" rx="7" />
