          <rect class="k-bar-strong" x="104" y="72" width="88" height="8" rx="4" />
          <rect class="k-bar" x="104" y="92" width="134" height="6" rx="3" />
          <rect class="k-bar" x="104" y="104" width="112" height="6" rx="3" />
          <rect class="k-bar" x="104" y="116" width="124" height="6" rx="3" />
          <rect class="k-ink" x="104" y="150" width="58" height="22" rx="11" />
          <rect class="k-card" x="170" y="150" width="54" height="22" rx="11" />
        </g>
        <path class="k-cursor pop" d="M148 166 v19 l5 -5 l4 9 l3.5 -1.5 l-4 -8.5 h7 z" style="--dd: 600ms" />
        <g class="stamp-pop" style="--dd: 1000ms">
          <g transform="rotate(-8 252 60)">
            <rect class="k-lime" x="206" y="42" width="96" height="34" rx="9" />
            <path class="k-check" d="M220 59 l6 6 l11 -12" />
            <text class="k-stamp-text" x="243" y="64">Akkoord</text>
