  }

  {
    kind === "chat" && (
      <g>
        <g class="pop" style="--dd: 0ms">
          <rect class="k-ink" x="146" y="36" width="176" height="48" rx="18" />
          <rect class="k-paper-bar" x="164" y="53" width="116" height="6" rx="3" />
          <rect class="k-paper-bar" x="164" y="65" width="82" height="6" rx="3" />
        </g>
        <g class="pop" style="--dd: 450ms">
          <rect class="k-card" x="38" y="100" width="210" height="72" rx="18" />
          <rect class="k-bar" x="56" y="118" width="156" height="6" rx="3" />
          <rect class="k-bar" x="56" y="132" width="172" height="6" rx="3" />
          <rect class="k-bar" x="56" y="146" width="110" height="6" rx="3" />
        </g>
        <g class="pop" style="--dd: 800ms">
          <rect class="k-tint" x="38" y="184" width="112" height="22" rx="11" />
          <path class="k-acc-line" d="M52 189.5 h6 l3 3 v8 h-9 z" />
          <rect class="k-acc" x="68" y="192" width="68" height="6" rx="3" />
        </g>
      </g>
    )
  }

  {
    kind === "compare" && (
      <g>
        <rect class="k-card pop" x="48" y="38" width="104" height="146" rx="12" style="--dd: 0ms" />
        <rect class="k-card pop" x="208" y="38" width="104" height="146" rx="12" style="--dd: 150ms" />
        {rows.map((y, i) => (
          <g>
            <rect class="k-bar" x="62" y={y} width={i === 0 ? 50 : 70} height="6" rx="3" />
            <rect class="k-bar" x="222" y={y} width={i === 0 ? 50 : 70} height="6" rx="3" />
            <path class="k-line draw" d={`M140 ${y + 3} H220`} pathLength="1" style={`--dd: ${400 + i * 120}ms`} />
          </g>
        ))}
        <g class="stamp-pop" style="--dd: 1200ms">
          <circle class="k-lime" cx="180" cy="208" r="14" />
          <path class="k-check" d="M173 208 l5 5 l9 -10" />
        </g>
      </g>
    )
  }

  {
    kind === "apps" && (
      <g>
        <g class="pop" style="--dd: 0ms">
          <rect class="k-card" x="36" y="48" width="184" height="140" rx="14" />
          <path class="k-line" d="M36 72 H220" />
          <circle class="k-bar-strong" cx="52" cy="60" r="3.5" />
          <circle class="k-bar-strong" cx="63" cy="60" r="3.5" />
          <circle class="k-bar-strong" cx="74" cy="60" r="3.5" />
          <rect class="k-bar" x="52" y="88" width="56" height="40" rx="8" />
          <rect class="k-bar" x="116" y="88" width="88" height="8" rx="4" />
          <rect class="k-bar" x="116" y="104" width="70" height="6" rx="3" />
          <rect class="k-bar" x="116" y="116" width="78" height="6" rx="3" />
          <rect class="k-bar" x="52" y="144" width="152" height="6" rx="3" />
          <rect class="k-bar" x="52" y="158" width="120" height="6" rx="3" />
        </g>
        <path class="k-line draw" d="M220 118 H282" pathLength="1" style="--dd: 400ms" />
        <text class="k-label pop" x="251" y="108" text-anchor="middle" style="--dd: 700ms">API</text>
        <g class="pop" style="--dd: 800ms">
          <circle class="k-acc" cx="302" cy="118" r="20" />
          <circle class="k-paper" cx="302" cy="118" r="6" />
        </g>
      </g>
    )
  }

  {
    kind === "agents" && (
      <g>
        <g class="orbit">
          <ellipse class="k-line" cx="180" cy="120" rx="118" ry="42" transform="rotate(-22 180 120)" />
          <circle class="k-card" cx="289" cy="76" r="9" />
        </g>
        <g class="orbit orbit--rev">
          <ellipse class="k-line" cx="180" cy="120" rx="118" ry="42" transform="rotate(22 180 120)" />
          <circle class="k-lime" cx="71" cy="76" r="9" />
          <circle class="k-card" cx="289" cy="164" r="7" />
        </g>
        <circle class="k-acc" cx="180" cy="120" r="18" />
        <circle class="k-paper" cx="180" cy="120" r="6" />
      </g>
    )
  }

  {
    kind === "phone" && (
      <g>
        <g class="pop" style="--dd: 0ms">
          <rect class="k-card" x="124" y="22" width="112" height="198" rx="22" />
          <rect class="k-ink" x="162" y="31" width="36" height="8" rx="4" />
          <rect class="k-acc" x="138" y="52" width="14" height="14" rx="4" />
          <rect class="k-bar" x="158" y="56" width="48" height="6" rx="3" />
          <rect class="k-bar-strong" x="138" y="80" width="76" height="9" rx="4.5" />
          <rect class="k-bar" x="138" y="95" width="54" height="5" rx="2.5" />
          <rect class="k-card" x="138" y="112" width="84" height="22" rx="7" />
          <rect class="k-card" x="138" y="140" width="84" height="22" rx="7" />
          <rect class="k-card" x="138" y="168" width="84" height="22" rx="7" />
        </g>
        <g class="pop" style="--dd: 600ms">
          <rect class="k-card" x="50" y="150" width="62" height="28" rx="14" />
          <rect class="k-bar" x="62" y="162" width="38" height="5" rx="2.5" />
        </g>
        <g class="stamp-pop" style="--dd: 900ms">
          <circle class="k-lime" cx="236" cy="28" r="9" />
