        <text class="k-label" x="74" y="164" text-anchor="middle">Voorstellen</text>
        <text class="k-label" x="150" y="164" text-anchor="middle">Steekproef</text>
        <text class="k-label" x="226" y="164" text-anchor="middle">Automatisch</text>
        <path class="k-line k-dashed" d="M296 62 V172" />
        <g class="pop" style="--dd: 400ms">
