          <rect class="k-bar-strong" x="270" y="76" width="50" height="6" rx="3" />
          <rect class="k-bar" x="270" y="90" width="58" height="5" rx="2.5" />
          <rect class="k-bar" x="270" y="100" width="40" height="5" rx="2.5" />
          <path class="k-line" d="M300 122 V144" />
          <circle class="k-lime" cx="300" cy="156" r="12" />
