---
const {
  heading = "Minder klikken, meer regelen.",
  text = "Zie in een demo hoe Insync het voorwerk doet in je eigen backoffice, met jouw soort werk.",
} = Astro.props;
---

<section aria-labelledby="cta-kop" style="max-width: 1240px; margin: 0 auto; padding: 0 24px 104px">
  <div
    style="position: relative; border-radius: 28px; background: #0A0A0A; color: #FFFFFF; padding: clamp(32px, 6vw, 72px); display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px"
  >
    <div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
      <span class="eyebrow" style="color: #A1A1AA">Demo inplannen</span>
      <h2 id="cta-kop" style="margin: 0; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.04; font-weight: 500; letter-spacing: -0.04em">
        {heading}
      </h2>
      <p style="margin: 0; font-size: 18px; line-height: 1.55; color: #A1A1AA; max-width: 560px">{text}</p>
    </div>
    <a href="/demo" class="btn" style="background: #C6F432; color: #0A0A0A">Demo inplannen</a>
  </div>
</section>
