---
import "../styles/global.css";
import "../styles/site.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import Umami from "../components/Umami.astro";

interface Faq {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  faqs?: Faq[];
  software?: boolean;
  article?: {
    datePublished?: string;
    dateModified?: string;
    image?: string;
  };
}

const {
  title,
  fullTitle,
  description = "Insync doet het voorwerk in je eigen backoffice, voor je team én je klanten. Een mens beslist, en jij bepaalt hoeveel ruimte de AI krijgt.",
  faqs = [],
  software = false,
  article,
} = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} – Insync` : "Insync – Minder klikken, meer regelen");
const siteUrl = "https://insync.insure";
const ogImage = `${siteUrl}/og-image.jpg`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Insync",
  url: siteUrl,
  logo: `${siteUrl}/logo.svg`,
  description:
    "Insync is het AI-platform voor adviseurs, volmachten en verzekeraars: de AI doet het voorwerk in je eigen backoffice, voor je team én je klanten. Een mens beslist.",
  sameAs: ["https://www.linkedin.com/company/insync-platform"],
  identifier: { "@type": "PropertyValue", propertyID: "KvK", value: "98808672" },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    telephone: "+31-6-18282389",
    email: "hello@insync.insure",
    url: `${siteUrl}/demo`,
  },
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Insync AI",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "AI-verwerkingsplatform voor adviseurs, volmachten en verzekeraars: een werkbak met voorbereide zaken, een actielaag die pas na een besluit wijzigt, en een doorlaatregeling waarmee je bepaalt wat vanzelf mag.",
  publisher: { "@type": "Organization", name: "Insync" },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description,
  url: Astro.url.href,
  inLanguage: "nl-NL",
  publisher: { "@type": "Organization", name: "Insync" },
};

const faqSchema = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const articleSchema = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      url: Astro.url.href,
      publisher: {
        "@type": "Organization",
        name: "Insync",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo.svg` },
      },
      ...(article.datePublished && { datePublished: article.datePublished }),
      ...(article.dateModified && { dateModified: article.dateModified }),
      ...(article.image && { image: article.image }),
    }
  : null;

const schemas = [
  webPageSchema,
  (software || Astro.url.pathname === "/") && organizationSchema,
  software && softwareSchema,
  faqSchema,
  articleSchema,
].filter(Boolean);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Insync" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <meta name="generator" content={Astro.generator} />
    <Umami id="5a34bef4-d77e-4dec-8273-166ae1c8d495" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Insync" />
    <meta property="og:locale" content="nl_NL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FFFFFF" />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class="site">
    <a href="#inhoud" class="skip-link">Naar de inhoud</a>
    <Header />
    <div id="inhoud">
      <slot />
    </div>
    <Footer />

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
